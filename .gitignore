# ── 本地数据与运行时（绝不入库）──────────────────────────────
data/
# 只忽略仓库根/运行时的 media 目录；internal/media 是源码包，必须入库
/media/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── 环境与凭据（仓库禁止提交任何真实配置）──────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
config.local.*
*_local.yaml

# ── 构建产物 ────────────────────────────────────────────────
/engram
/bin/
/dist/
*.test
*.out
/coverage.*
*.prof
# Rust 优化器适配器（tools/optimizer）的构建输出
tools/optimizer/target/

# ── 生成物（构建时重新生成，不入库）────────────────────────
*_templ.go
internal/web/static/css/tailwind.css
node_modules/

# ── 本地产物 / 测试夹具 ────────────────────────────────────
/tmp/
*.local.json
testdata/local/
*.log

# ── 编辑器与系统 ───────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store

# ── 本地进度台账（不入库；AGENTS.md 的勾选在此暂存）──────────
PROGRESS.local.md
