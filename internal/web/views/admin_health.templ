package views

// adminHealth 渲染健康页（M6-8）：数据库连通、schema 版本、媒体目录占用、到期队列量。\n// 每个读数用 data-health=<key> 标注，便于测试按标识取出值与独立计算值对比。
templ adminHealth(data AdminPageData) {
	<div class="space-y-4">
		<dl class="divide-y divide-zinc-100 dark:divide-zinc-800">
			for _, row := range data.HealthRows {
				<div class="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:justify-between">
					<div class="space-y-0.5">
						<dt class="text-sm font-semibold text-zinc-950 dark:text-zinc-100">{ row.Label }</dt>
						<dd class="text-xs text-zinc-400 dark:text-zinc-500">{ row.Hint }</dd>
					</div>
					<dd class="font-mono text-base font-bold text-zinc-900 dark:text-zinc-100" data-health={ row.Key }>{ row.Value }</dd>
				</div>
			}
		</dl>
	</div>
}
