package views

// SharingPage 是卡组共享管理页（M5-2）：授权列表 + 授予/改角色/撤销。
// 只有 owner 能打开与提交（handler 用 DeckAccess 判定）；模板不含任何硬编码用户文案。
// 分享链接（M5-3）与可见性开关（M5-5）尚未实现，在页尾预留了区块注释，不写入口。
templ SharingPage(data SharingData) {
	@Base(data.Layout) {
		<div class="space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
				if data.DeckName != "" {
					<p class="mt-1 text-sm font-medium text-zinc-500">{ data.DeckName }</p>
				}
			</div>

			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs" role="alert">
					{ data.ErrorMessage }
				</div>
			}

			<!-- 授权成员表格 -->
			if len(data.Rows) == 0 {
				<div class="rounded-2xl border border-zinc-200/80 bg-white p-12 text-center shadow-xs">
					<p class="text-sm font-medium text-zinc-500">{ data.EmptyText }</p>
				</div>
			} else {
				<div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white shadow-xs">
					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead class="border-b border-zinc-200/80 bg-zinc-50/70 text-xs font-semibold uppercase tracking-wider text-zinc-500">
								<tr>
									<th class="px-5 py-3.5 sm:px-6">{ data.ColUser }</th>
									<th class="px-5 py-3.5 sm:px-6">{ data.ColRole }</th>
									<th class="px-5 py-3.5 sm:px-6 text-right">{ data.ColActions }</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-zinc-100">
								for _, row := range data.Rows {
									<tr class="hover:bg-zinc-50/60 transition-colors align-top">
										<td class="px-5 py-4 sm:px-6 font-semibold text-zinc-950">{ row.Username }</td>
										<td class="px-5 py-4 sm:px-6">
											<span class="inline-flex items-center rounded-md bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-700">{ row.RoleLabel }</span>
										</td>
										<td class="px-5 py-4 sm:px-6 text-right">
											if row.Editable {
												<div class="flex flex-wrap items-center justify-end gap-2">
													<form class="flex items-center gap-2" method="post" action={ row.RoleAction }>
														<input type="hidden" name="csrf_token" value={ data.CSRF }/>
														<input type="hidden" name="user_id" value={ row.UserValue }/>
														<select class="rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors cursor-pointer" name="role">
															for _, opt := range row.RoleOptions {
																if opt.Selected {
																	<option value={ opt.Value } selected>{ opt.Label }</option>
																} else {
																	<option value={ opt.Value }>{ opt.Label }</option>
																}
															}
														</select>
														<button class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 transition-colors cursor-pointer" type="submit">{ row.ChangeLabel }</button>
													</form>
													<form method="post" action={ row.RevokeAction }>
														<input type="hidden" name="csrf_token" value={ data.CSRF }/>
														<input type="hidden" name="user_id" value={ row.UserValue }/>
														<button class="inline-flex items-center rounded-lg border border-rose-200 bg-white px-2.5 py-1 text-xs font-medium text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 transition-colors cursor-pointer" type="submit">{ row.RevokeLabel }</button>
													</form>
												</div>
											} else {
												<p class="text-xs text-zinc-400">{ data.OwnerNote }</p>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- 添加授权卡片 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-5">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.GrantHeading }</h2>
				</div>
				<form class="space-y-4" method="post" action={ data.GrantAction }>
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.UsernameLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="text" name="username" placeholder={ data.UsernamePlaceholder } required/>
					</label>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.RoleLabel }</span>
						<select class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors cursor-pointer" name="role">
							for _, opt := range data.RoleOptions {
								if opt.Selected {
									<option value={ opt.Value } selected>{ opt.Label }</option>
								} else {
									<option value={ opt.Value }>{ opt.Label }</option>
								}
							}
						</select>
					</label>
					<div class="pt-2">
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.GrantSubmit }</button>
					</div>
				</form>
			</section>

			<!-- 分享链接管理 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-5">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.LinksHeading }</h2>
				</div>
				if data.NewLinkURL != "" {
					<div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 text-sm text-emerald-900 shadow-2xs space-y-2">
						<p class="font-medium">{ data.NewLinkNotice }</p>
						<input class="w-full rounded-lg border border-emerald-300 bg-white px-3 py-2 font-mono text-xs text-zinc-800 select-all" type="text" readonly value={ data.NewLinkURL }/>
					</div>
				}
				if len(data.LinkRows) == 0 {
					<p class="text-xs text-zinc-400">{ data.LinksEmpty }</p>
				} else {
					<div class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
						<table class="w-full text-left text-sm">
							<thead class="border-b border-zinc-200/80 bg-zinc-50/70 text-xs font-semibold uppercase tracking-wider text-zinc-500">
								<tr>
									<th class="px-4 py-3">{ data.ColLink }</th>
									<th class="px-4 py-3">{ data.ColPassword }</th>
									<th class="px-4 py-3">{ data.ColExpires }</th>
									<th class="px-4 py-3">{ data.ColState }</th>
									<th class="px-4 py-3 text-right">{ data.ColActions }</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-zinc-100">
								for _, row := range data.LinkRows {
									<tr class="hover:bg-zinc-50/60 transition-colors align-top">
										<td class="px-4 py-3 font-mono text-xs font-medium text-zinc-900">{ row.Prefix }</td>
										<td class="px-4 py-3 text-xs text-zinc-600">{ row.PasswordText }</td>
										<td class="px-4 py-3 text-xs text-zinc-600 font-mono">{ row.ExpiresText }</td>
										<td class="px-4 py-3">
											<span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-700">{ row.StateText }</span>
										</td>
										<td class="px-4 py-3 text-right">
											if row.Active {
												<form method="post" action={ row.RevokeAction }>
													<input type="hidden" name="csrf_token" value={ data.CSRF }/>
													<input type="hidden" name="link" value={ row.TokenValue }/>
													<button class="inline-flex items-center rounded-lg border border-rose-200 bg-white px-2.5 py-1 text-xs font-medium text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 transition-colors cursor-pointer" type="submit">{ row.RevokeLabel }</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<form class="mt-3" method="post" action={ data.RevokeAllAction }>
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<button class="inline-flex items-center rounded-xl border border-rose-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 transition-colors cursor-pointer" type="submit">{ data.RevokeAllLabel }</button>
					</form>
				}
				<form class="mt-4 space-y-4 pt-4 border-t border-zinc-100" method="post" action={ data.CreateLinkAction }>
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.PasswordLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="text" name="password" autocomplete="new-password"/>
						<span class="mt-1 block text-xs text-zinc-400">{ data.PasswordHint }</span>
					</label>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.ExpiresLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="date" name="expires_at"/>
						<span class="mt-1 block text-xs text-zinc-400">{ data.ExpiresHint }</span>
					</label>
					<div class="pt-2">
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.CreateLinkLabel }</button>
					</div>
				</form>
			</section>

			<!-- 可见性管理 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-4">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.VisibilityHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500">{ data.VisibilityNote }</p>
				</div>
				<form class="flex flex-wrap items-end gap-3" method="post" action={ data.VisibilityAction }>
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.VisibilityLabel }</span>
						<select class="mt-1.5 rounded-xl border border-zinc-200 bg-white px-3.5 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors cursor-pointer" name="visibility">
							for _, opt := range data.VisibilityOptions {
								if opt.Selected {
									<option value={ opt.Value } selected>{ opt.Label }</option>
								} else {
									<option value={ opt.Value }>{ opt.Label }</option>
								}
							}
						</select>
					</label>
					<button class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.VisibilitySubmit }</button>
				</form>
			</section>
		</div>
	}
}
