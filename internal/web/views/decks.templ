package views

// DeckListPage 是卡组列表与新建页（M2-11）：上半部分列出我的卡组，下半部分是新建表单。
templ DeckListPage(data DeckListData) {
	@Base(data.Layout) {
		<h1 class="text-2xl font-bold text-slate-900">{ data.Heading }</h1>
		if len(data.Rows) == 0 {
			<p class="mt-4 text-slate-600">{ data.EmptyText }</p>
		} else {
			<table class="mt-4 w-full text-left text-sm">
				<thead class="border-b border-slate-200 text-slate-500">
					<tr>
						<th class="py-2">{ data.ColName }</th>
						<th class="py-2">{ data.ColCards }</th>
						<th class="py-2">{ data.ColDue }</th>
						<th class="py-2">{ data.ColActions }</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr class="border-b border-slate-100">
							<td class="py-2">
								<a class="text-blue-600 hover:underline" href={ row.Href }>{ row.Name }</a>
								if row.Archived {
									<span class="ml-2 rounded bg-slate-200 px-1 text-xs text-slate-600">{ data.Archived }</span>
								}
							</td>
							<td class="py-2">{ row.CardCount }</td>
							<td class="py-2">{ row.DueCount }</td>
							<td class="py-2">
								<a class="text-blue-600 hover:underline" href={ row.ExportHref } download>{ data.ExportLabel }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<section class="mt-8 rounded-lg border border-slate-200 bg-white p-4">
			<h2 class="text-lg font-semibold text-slate-900">{ data.NewHeading }</h2>
			if data.ErrorMessage != "" {
				<p class="mt-2 rounded bg-red-50 px-3 py-2 text-sm text-red-700">{ data.ErrorMessage }</p>
			}
			<form class="mt-4 space-y-3" method="post" action="/decks">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<label class="block text-sm text-slate-700">
					<span>{ data.NameLabel }</span>
					<input class="mt-1 w-full rounded border border-slate-300 px-2 py-1" type="text" name="name" value={ data.NameValue }/>
				</label>
				<label class="block text-sm text-slate-700">
					<span>{ data.DescLabel }</span>
					<input class="mt-1 w-full rounded border border-slate-300 px-2 py-1" type="text" name="description" value={ data.DescValue }/>
				</label>
				<label class="block text-sm text-slate-700">
					<span>{ data.PresetLabel }</span>
					<select class="mt-1 w-full rounded border border-slate-300 px-2 py-1" name="preset_id">
						for _, p := range data.Presets {
							<option value={ p.Value } selected?={ p.Selected }>{ p.Label }</option>
						}
					</select>
				</label>
				<button class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" type="submit">{ data.CreateLabel }</button>
			</form>
		</section>
	}
}
