package views

// adminI18n 渲染语言包完整度报告（M8-4）：每种语言的翻译覆盖率与缺失的 key。
// 覆盖率与缺失列表由 handler 从语言包 key 集合算出后传入；模板不含硬编码文字。
// 每行用 data-locale 标注、覆盖率用 data-coverage 标注，便于测试定位。
templ adminI18n(data AdminPageData) {
	<div class="space-y-6">
		if data.I18nAllComplete {
			<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 shadow-xs">{ data.I18nAllCompleteLabel }</div>
		}
		<div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-zinc-200/80 bg-zinc-50/70 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:border-zinc-800 dark:bg-zinc-800/60 dark:text-zinc-400">
						<tr>
							<th class="px-4 py-3 sm:px-5 font-semibold">{ data.ColI18nLocale }</th>
							<th class="px-4 py-3 font-semibold">{ data.ColI18nCoverage }</th>
							<th class="px-4 py-3 font-semibold">{ data.ColI18nStatus }</th>
							<th class="px-4 py-3 sm:px-5 font-semibold">{ data.ColI18nMissing }</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
						for _, row := range data.I18nRows {
							<tr class="hover:bg-zinc-50/60 dark:hover:bg-zinc-800/50 transition-colors align-top" data-locale={ row.Code }>
								<td class="px-4 py-3.5 sm:px-5 font-mono text-sm font-semibold text-zinc-950 dark:text-zinc-100">{ row.Code }</td>
								<td class="px-4 py-3.5 font-mono text-sm font-bold text-zinc-900 dark:text-zinc-100" data-coverage={ row.Code }>{ row.Percent }</td>
								<td class="px-4 py-3.5 text-xs text-zinc-600 dark:text-zinc-400">{ row.Counts }</td>
								<td class="px-4 py-3.5 sm:px-5 text-xs text-zinc-600 dark:text-zinc-300">
									<span class="font-medium">{ row.StatusLabel }</span>
									if row.MissingKeys != "" {
										<span class="ml-2 block mt-1 break-all font-mono text-[11px] text-zinc-400 dark:text-zinc-500">{ row.MissingKeys }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
