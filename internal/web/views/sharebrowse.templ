package views

// ShareBrowsePage 是免注册只读浏览页（M5-3）。
// 匿名可见但不可复习：页面只渲染卡组内容与一个「登录后开始复习」的提示，不含任何进度。
// 设了口令的链接在解锁前只渲染口令表单，不渲染任何内容。
templ ShareBrowsePage(data ShareBrowseData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-3xl space-y-6">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.Heading }</h1>
				if data.DeckName != "" {
					<p class="mt-1 text-sm font-medium text-zinc-500 dark:text-zinc-400">{ data.DeckName }</p>
				}
			</div>

			if data.PasswordRequired {
				<div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
					<p class="text-sm text-zinc-600 dark:text-zinc-400">{ data.Intro }</p>
					if data.PasswordError != "" {
						<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">
							{ data.PasswordError }
						</div>
					}
					<form class="space-y-4" method="post" action={ data.UnlockAction }>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.PasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="password" name="password" autocomplete="off" placeholder={ data.PasswordPlaceholder } required/>
						</label>
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.UnlockSubmit }</button>
					</form>
				</div>
			} else {
				<div class="rounded-2xl border border-indigo-100 bg-indigo-50/60 dark:border-indigo-900/50 dark:bg-indigo-950/30 p-5 text-sm text-indigo-950 dark:text-indigo-200 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<p class="font-medium">{ data.ReviewPrompt }</p>
					<a class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-indigo-700 active:scale-[0.98] transition-all shrink-0" href={ data.LoginHref }>{ data.LoginLabel }</a>
				</div>
				if len(data.Notes) == 0 {
					<div class="rounded-2xl border border-zinc-200/80 bg-white p-12 text-center shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
						<p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{ data.EmptyText }</p>
					</div>
				} else {
					<ul class="space-y-4">
						for _, note := range data.Notes {
							<li class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
								<div>
									<p class="text-[11px] font-semibold tracking-wider text-zinc-500 dark:text-zinc-400 uppercase">{ data.FrontLabel }</p>
									<div class="mt-2 text-base text-zinc-950 dark:text-zinc-100 leading-relaxed">{ note.FrontHTML }</div>
								</div>
								<div class="border-t border-dashed border-zinc-200 dark:border-zinc-800 pt-4">
									<p class="text-[11px] font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">{ data.BackLabel }</p>
									<div class="mt-2 text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">{ note.BackHTML }</div>
								</div>
							</li>
						}
					</ul>
				}
			}
		</div>
	}
}
