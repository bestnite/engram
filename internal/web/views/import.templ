package views

// ImportPage 渲染卡组包上传页：上传表单 + 可选的导入摘要/错误（M5-9）。
templ ImportPage(data ImportPageData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-3xl space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
				<p class="mt-1 text-sm text-zinc-600 leading-relaxed">{ data.Intro }</p>
			</div>

			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs" role="alert">
					{ data.ErrorMessage }
				</div>
			}

			<!-- 上传表单卡片 -->
			<div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs">
				<form class="space-y-5" method="post" action={ data.FormAction } enctype="multipart/form-data">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.FileLabel }</span>
						<input class="mt-2 block w-full text-xs text-zinc-600 file:mr-3 file:rounded-xl file:border-0 file:bg-zinc-950 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-white file:shadow-2xs hover:file:bg-zinc-800 file:cursor-pointer" type="file" name="file" required/>
					</label>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.TargetLabel }</span>
							<select class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors cursor-pointer" name="target">
								for _, opt := range data.Targets {
									<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
								}
							</select>
						</label>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.DeckIDLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="text" name="deck_id" value=""/>
						</label>
					</div>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.OnConflictLabel }</span>
						<select class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors cursor-pointer" name="on_conflict">
							for _, opt := range data.OnConflicts {
								<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
							}
						</select>
					</label>
					<div class="space-y-2 pt-1">
						<label class="flex items-center gap-2.5 text-sm font-medium text-zinc-700 cursor-pointer">
							<input type="checkbox" name="dry_run" value="1" class="h-4 w-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900"/>
							<span>{ data.DryRunLabel }</span>
						</label>
						if data.AllowOthersShow {
							<label class="flex items-center gap-2.5 text-sm font-medium text-zinc-700 cursor-pointer">
								<input type="checkbox" name="allow_others_progress" value="1" class="h-4 w-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900"/>
								<span>{ data.AllowOthersLabel }</span>
							</label>
						}
					</div>
					<div class="pt-3 border-t border-zinc-100">
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.SubmitLabel }</button>
					</div>
				</form>
			</div>

			<!-- 导入结果摘要 -->
			if data.Result != nil {
				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-6">
					<div>
						<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.Result.Heading }</h2>
					</div>
					<div class="overflow-hidden rounded-xl border border-zinc-100 bg-zinc-50/50">
						<table class="w-full text-left text-sm">
							<tbody class="divide-y divide-zinc-100">
								for _, row := range data.Result.Rows {
									<tr>
										<td class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500 w-1/3">{ row.Label }</td>
										<td class="px-4 py-3 font-mono text-sm font-medium text-zinc-900">{ row.Value }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<div class="space-y-3">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.Result.ErrorsHead }</h3>
						if len(data.Result.Errors) == 0 {
							<p class="text-xs font-medium text-zinc-400">{ data.Result.NoErrors }</p>
						} else {
							<div class="overflow-hidden rounded-xl border border-rose-100 bg-rose-50/30">
								<table class="w-full text-left text-sm">
									<thead class="border-b border-rose-100 bg-rose-50/70 text-xs font-semibold uppercase tracking-wider text-rose-700">
										<tr>
											<th class="px-4 py-3">{ data.Result.ColEntry }</th>
											<th class="px-4 py-3">{ data.Result.ColReason }</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-rose-100">
										for _, e := range data.Result.Errors {
											<tr class="align-top text-xs text-rose-900">
												<td class="px-4 py-3 font-mono font-medium">{ e.Entry }</td>
												<td class="px-4 py-3">{ e.Reason }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				</section>
			}
		</div>
	}
}
