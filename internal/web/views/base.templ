package views

// Base 是所有页面的外壳：负责文档结构、语言标记、哈希化静态资源引用与页头/页脚。
templ Base(data LayoutData) {
	<!DOCTYPE html>
	<html lang={ data.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#2563eb"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<title>{ data.Title }</title>
			if data.CSSURL != "" {
				<link rel="stylesheet" href={ data.CSSURL }/>
			}
			if data.HTMXURL != "" {
				<script src={ data.HTMXURL } defer></script>
			}
			if data.MathJaxURL != "" {
				<script src={ data.MathJaxURL } defer></script>
			}
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
			<header class="border-b border-slate-200 bg-white">
				<nav class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-3">
					<a class="font-semibold text-blue-600" href={ data.HomeURL }>{ data.Brand }</a>
					for _, item := range data.Nav {
						<a class="text-sm text-slate-600 hover:text-slate-900" href={ item.Href }>{ item.Label }</a>
					}
					if data.SessionForm {
						<form class="ml-auto" method="post" action={ data.SessionHref }>
							if data.CSRF != "" {
								<input type="hidden" name="csrf_token" value={ data.CSRF }/>
							}
							<button class="text-sm text-slate-600 hover:text-slate-900" type="submit">{ data.SessionLabel }</button>
						</form>
					} else if data.SessionLabel != "" {
						<a class="ml-auto text-sm text-slate-600 hover:text-slate-900" href={ data.SessionHref }>{ data.SessionLabel }</a>
					}
				</nav>
			</header>
			<main class="mx-auto max-w-3xl px-4 py-8">
				{ children... }
			</main>
			<footer class="mx-auto max-w-3xl px-4 pb-8 text-xs text-slate-400">
				{ data.Footer }
			</footer>
			<script src="/pwa.js" defer></script>
		</body>
	</html>
}
