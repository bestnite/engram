package views

// LanguageSwitcher 是页头的语言切换下拉，所有页面外壳共用（也由 htmx 就地替换）。
//
// 访客：每个选项是指向当前页面、覆盖 lang 参数的链接，只作用于本次请求。
// 已登录：每个选项是带 CSRF 的 POST（写 users.locale，DESIGN.md §8.3），并带 htmx 属性——
// 有脚本时就地替换本组件（不重新加载整页），没有脚本时退回普通表单提交并 303 回本页。
templ LanguageSwitcher(data LayoutData) {
	if len(data.LangOptions) > 0 {
		<details id="lang-switcher" class="relative">
			<summary aria-label={ data.LanguageLabel } class="flex h-8 items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-2.5 text-zinc-600 shadow-2xs hover:bg-zinc-50 hover:text-zinc-950 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 dark:hover:text-zinc-50 transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
				<span class="hidden text-xs font-medium sm:inline">{ data.CurrentLanguage }</span>
			</summary>
			<div class="absolute right-0 z-50 mt-1 min-w-36 overflow-hidden rounded-xl border border-zinc-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
				for _, l := range data.LangOptions {
					if l.Active {
						<span class="flex items-center px-3.5 py-2 text-xs font-semibold text-zinc-950 dark:text-zinc-50">{ l.Label }</span>
					} else if data.LangForm != nil {
						<form method="post" action={ data.LangForm.Action } class="contents" hx-post={ data.LangForm.Action } hx-target="#lang-switcher" hx-swap="outerHTML">
							<input type="hidden" name="csrf_token" value={ data.LangForm.CSRF }/>
							<input type="hidden" name="lang" value={ l.Code }/>
							<input type="hidden" name="next" value={ data.LangForm.Next }/>
							if data.LangForm.OOBLocaleControl {
								<input type="hidden" name="oob" value={ SettingsLocaleControlID }/>
							}
							<button type="submit" class="flex w-full items-center px-3.5 py-2 text-left text-xs font-medium text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-300 dark:hover:bg-zinc-700 dark:hover:text-zinc-50 transition-colors cursor-pointer">{ l.Label }</button>
						</form>
					} else {
						<a class="flex items-center px-3.5 py-2 text-xs font-medium text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-300 dark:hover:bg-zinc-700 dark:hover:text-zinc-50 transition-colors" href={ l.Href }>{ l.Label }</a>
					}
				}
			</div>
		</details>
	}
}

// LanguageSwitchResponse 是语言切换的 htmx 响应：第一个片段替换页头下拉（主交换），
// 第二个（可选）用 hx-swap-oob 带外替换设置页的语言控件。带外片段必须自带
// id 与 hx-swap-oob，htmx 会先摘走它、再把剩下的内容换进 hx-target。
templ LanguageSwitchResponse(data LanguageSwitchData) {
	@LanguageSwitcher(data.Layout)
	if data.IncludeLocaleControl {
		@SettingsLocaleControl(data.LocaleLabel, data.LocaleOptions, templ.Attributes{"hx-swap-oob": "outerHTML"})
	}
}

// Base 是所有页面的外壳：负责文档结构、语言标记、哈希化静态资源引用与页头/页脚。
templ Base(data LayoutData) {
	<!DOCTYPE html>
	<html lang={ data.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#18181b"/>
			// 主题引导（M8-8）：必须内联且早于样式表，否则暗色下会先画一帧白底。
			// 放在 theme-color 之后，因为它会同步该 meta；内容来自 Go 常量 themeBootstrap
			//（常量自带 <script> 标签，模板里不写 JS 字面量）。
			@rawHTML(data.ThemeBootstrap)
			<link rel="manifest" href="/manifest.webmanifest"/>
			if data.IconURL != "" {
				<link rel="icon" type="image/svg+xml" href={ data.IconURL }/>
			}
			if data.AppleTouchIconURL != "" {
				<link rel="apple-touch-icon" href={ data.AppleTouchIconURL }/>
			}
			<title>{ data.Title }</title>
			if data.CSSURL != "" {
				<link rel="stylesheet" href={ data.CSSURL }/>
			}
			if data.HTMXURL != "" {
				<script src={ data.HTMXURL } defer></script>
			}
			if data.MathJaxURL != "" {
				<script src={ data.MathJaxURL } defer></script>
			}
			if data.MediaJSURL != "" {
				<script src={ data.MediaJSURL } defer></script>
			}
			<script src="/pwa.js"></script>
		</head>
		<body class="min-h-screen flex flex-col bg-slate-50 text-zinc-900 antialiased selection:bg-zinc-200 selection:text-zinc-950 dark:bg-zinc-950 dark:text-zinc-100 dark:selection:bg-zinc-800 dark:selection:text-zinc-100 transition-colors duration-150">
			<header class="sticky top-0 z-30 border-b border-zinc-200/80 bg-white/90 dark:border-zinc-800 dark:bg-zinc-900/90 backdrop-blur-md">
				<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
					<div class="flex items-center gap-6">
						<a class="flex items-center gap-2.5 font-bold tracking-tight text-zinc-950 dark:text-zinc-100 hover:opacity-90 transition-opacity" href={ data.HomeURL }>
							<span class="flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-950 shadow-2xs">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7.1" y="1.2" width="16.6" height="12.5" rx="2.5" opacity="0.35"></rect><rect x="4.2" y="5.3" width="16.6" height="12.5" rx="2.5" opacity="0.68"></rect><rect x="1.3" y="9.4" width="16.6" height="12.5" rx="2.5"></rect></svg>
							</span>
							<span class="text-base font-semibold">{ data.Brand }</span>
						</a>
						if len(data.Nav) > 0 {
							<div class="hidden sm:flex items-center gap-1">
								for _, item := range data.Nav {
									if item.Active {
										<a aria-current="page" class="rounded-lg px-3 py-1.5 text-sm font-medium hover:bg-zinc-100 hover:text-zinc-950 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 font-semibold" href={ item.Href }>{ item.Label }</a>
									} else {
										<a class="rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors" href={ item.Href }>{ item.Label }</a>
									}
								}
							</div>
						}
					</div>
					<div class="flex items-center gap-2">
						<!-- 语言切换下拉（所有页面外壳共用，覆盖 lang 并保留当前路径与查询参数） -->
						@LanguageSwitcher(data)

						<!-- 主题切换按钮 -->
						<button type="button" data-theme-toggle class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 shadow-2xs hover:bg-zinc-50 hover:text-zinc-950 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 dark:hover:text-zinc-50 transition-colors cursor-pointer">
							<svg class="theme-icon-sun hidden h-4 w-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
							<svg class="theme-icon-moon h-4 w-4 text-zinc-700 dark:text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
						</button>

						<!-- 桌面端会话入口 -->
						if data.SessionForm {
							<form class="hidden sm:block" method="post" action={ data.SessionHref }>
								if data.CSRF != "" {
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
								}
								<button class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs sm:text-sm font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer" type="submit">{ data.SessionLabel }</button>
							</form>
						} else if data.SessionLabel != "" {
							<a class="hidden sm:inline-flex rounded-lg bg-zinc-950 px-3 py-1.5 text-xs sm:text-sm font-medium text-white shadow-2xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white transition-colors" href={ data.SessionHref }>{ data.SessionLabel }</a>
						}

						<!-- 移动端汉堡菜单触发按钮 -->
						if len(data.Nav) > 0 || data.SessionLabel != "" {
							<button id="mobile-nav-toggle" type="button" class="sm:hidden flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:text-zinc-950 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors cursor-pointer">
								<svg id="mobile-nav-icon-bars" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
								<svg id="mobile-nav-icon-close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
							</button>
						}
					</div>
				</nav>

				<!-- 移动端抽屉遮罩与下拉菜单 -->
				<div id="mobile-nav-backdrop" class="fixed inset-0 z-40 bg-zinc-950/40 backdrop-blur-xs hidden sm:hidden"></div>
				<div id="mobile-nav-menu" class="hidden sm:hidden relative z-50 border-t border-zinc-200/80 bg-white/95 dark:border-zinc-800 dark:bg-zinc-900/95 backdrop-blur-md p-4 space-y-3 shadow-lg">
					if len(data.Nav) > 0 {
						<div class="space-y-1">
							for _, item := range data.Nav {
								if item.Active {
									<a aria-current="page" class="flex items-center min-h-11 rounded-xl px-3.5 py-2.5 text-sm font-medium hover:bg-zinc-100 hover:text-zinc-950 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 font-semibold" href={ item.Href }>{ item.Label }</a>
								} else {
									<a class="flex items-center min-h-11 rounded-xl px-3.5 py-2.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors" href={ item.Href }>{ item.Label }</a>
								}
							}
						</div>
					}
					if data.SessionForm {
						<form class="pt-2 border-t border-zinc-100 dark:border-zinc-800" method="post" action={ data.SessionHref }>
							if data.CSRF != "" {
								<input type="hidden" name="csrf_token" value={ data.CSRF }/>
							}
							<button class="w-full flex items-center justify-center min-h-11 rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer" type="submit">{ data.SessionLabel }</button>
						</form>
					} else if data.SessionLabel != "" {
						<div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
							<a class="w-full flex items-center justify-center min-h-11 rounded-xl bg-zinc-950 px-4 py-2.5 text-sm font-semibold text-white shadow-2xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white transition-colors" href={ data.SessionHref }>{ data.SessionLabel }</a>
						</div>
					}
				</div>
			</header>
			<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
				{ children... }
			</main>
			<footer class="border-t border-zinc-200/60 bg-white dark:border-zinc-800/80 dark:bg-zinc-900">
				<div class="mx-auto flex max-w-6xl items-center justify-center px-4 py-6 sm:px-6 text-xs text-zinc-500 dark:text-zinc-400 font-medium">
					<a class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors" href={ data.RepoURL }>{ data.Footer }</a>
				</div>
			</footer>
		</body>
	</html>
}
