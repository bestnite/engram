package views

// adminAPIKeys 渲染 API Key 总览（M6-9）：名称、归属、前缀、scopes、最后使用、过期、状态。
// 只展示元信息：库里存的是 sha256，页面无明文可展示；前缀是创建时截取的展示用片段。
// 每行用 data-key-id 标注，便于测试定位；可用的 key 提供撤销入口（写操作，带 CSRF）。
templ adminAPIKeys(data AdminPageData) {
	if len(data.APIKeyRows) == 0 {
		<p class="mt-4 text-sm text-slate-500">{ data.EmptyLabel }</p>
	} else {
		<table class="mt-4 w-full text-left text-sm">
			<thead>
				<tr class="border-b border-slate-200 text-xs text-slate-400">
					<th class="py-2 pr-3 font-medium">{ data.ColKeyName }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyOwner }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyPrefix }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyScopes }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyLastUsed }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyExpires }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColKeyState }</th>
					<th class="py-2 font-medium">{ data.ColKeyActions }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range data.APIKeyRows {
					<tr class="border-b border-slate-100" data-key-id={ row.ID }>
						<td class="py-2 pr-3 text-slate-800">{ row.Name }</td>
						<td class="py-2 pr-3 text-slate-600">{ row.Owner }</td>
						<td class="py-2 pr-3 font-mono text-slate-600">{ row.Prefix }</td>
						<td class="py-2 pr-3 text-slate-600">{ row.Scopes }</td>
						<td class="py-2 pr-3 text-slate-600">{ row.LastUsed }</td>
						<td class="py-2 pr-3 text-slate-600">{ row.Expires }</td>
						<td class="py-2 pr-3 text-slate-600">{ row.StateLabel }</td>
						<td class="py-2">
							if row.CanRevoke {
								<form method="post" action={ row.RevokeHref }>
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
									<button class="rounded border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100" type="submit">{ data.KeyRevokeLabel }</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}