package views

// adminSMTP 渲染 SMTP 配置页（M1-17）：传输参数、口令配置状态、「测试连接」按钮与结果，
// 以及 outbox 队列表的读数（是否已配置、待投递/失败计数、最后一次错误与尝试次数）。
// 文案全部来自 AdminPageData.SMTP。
templ adminSMTP(data AdminPageData) {
	if data.SMTP != nil {
		<form class="space-y-4" method="post" action={ data.SMTP.FormAction }>
			<input type="hidden" name="csrf_token" value={ data.SMTP.CSRF }/>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.HostLabel }</span>
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="smtp_host" value={ data.SMTP.HostValue }/>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.HostHint }</span>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.HostSource }</span>
			</label>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.PortLabel }</span>
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="smtp_port" value={ data.SMTP.PortValue }/>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.PortHint }</span>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.PortSource }</span>
			</label>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.UsernameLabel }</span>
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="smtp_username" value={ data.SMTP.UsernameValue }/>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.UsernameHint }</span>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.UsernameSource }</span>
			</label>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.PasswordLabel }</span>
				<span class="mt-1 block text-sm text-slate-600">{ data.SMTP.PasswordStatus }</span>
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="password" name="smtp_password" value="" autocomplete="new-password"/>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.PasswordHint }</span>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.PasswordSource }</span>
			</label>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.FromLabel }</span>
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="smtp_from" value={ data.SMTP.FromValue }/>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.FromHint }</span>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.FromSource }</span>
			</label>
			<label class="block">
				<span class="text-sm font-medium text-slate-700">{ data.SMTP.TLSModeLabel }</span>
				<select class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" name="smtp_tls_mode">
					for _, opt := range data.SMTP.TLSModeOptions {
						<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
					}
				</select>
				<span class="mt-0.5 block text-xs text-slate-400">{ data.SMTP.TLSModeHint }</span>
			</label>
			<button class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" type="submit">{ data.SMTP.SaveLabel }</button>
		</form>
		<form class="mt-4" method="post" action={ data.SMTP.TestAction }>
			<input type="hidden" name="csrf_token" value={ data.SMTP.CSRF }/>
			<input type="hidden" name="smtp_host" value={ data.SMTP.HostValue }/>
			<input type="hidden" name="smtp_port" value={ data.SMTP.PortValue }/>
			<input type="hidden" name="smtp_username" value={ data.SMTP.UsernameValue }/>
			<input type="hidden" name="smtp_from" value={ data.SMTP.FromValue }/>
			<input type="hidden" name="smtp_tls_mode" value={ data.SMTP.TLSModeValue }/>
			<button class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" type="submit">{ data.SMTP.TestLabel }</button>
		</form>
		if data.SMTP.TestResult != "" {
			if data.SMTP.TestOK {
				<div class="mt-3 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-800">{ data.SMTP.TestResult }</div>
			} else {
				<div class="mt-3 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">{ data.SMTP.TestResult }</div>
			}
		}
		<section class="mt-8 border-t border-slate-200 pt-6">
			<h2 class="text-sm font-semibold text-slate-500">{ data.SMTP.OutboxHeading }</h2>
			<p class="mt-1 text-xs text-slate-400">{ data.SMTP.OutboxIntro }</p>
			<table class="mt-3 w-full text-left text-sm">
				<tbody>
					<tr class="border-b border-slate-100 align-top">
						<td class="py-2 pr-3 font-medium text-slate-800">{ data.SMTP.OutboxConfiguredLabel }</td>
						<td class="py-2 text-slate-600">{ data.SMTP.OutboxConfiguredStatus }</td>
					</tr>
					<tr class="border-b border-slate-100 align-top">
						<td class="py-2 pr-3 font-medium text-slate-800">{ data.SMTP.OutboxPendingLabel }</td>
						<td class="py-2 text-slate-600">{ data.SMTP.OutboxPending }</td>
					</tr>
					<tr class="border-b border-slate-100 align-top">
						<td class="py-2 pr-3 font-medium text-slate-800">{ data.SMTP.OutboxFailedLabel }</td>
						<td class="py-2 text-slate-600">{ data.SMTP.OutboxFailed }</td>
					</tr>
					<tr class="border-b border-slate-100 align-top">
						<td class="py-2 pr-3 font-medium text-slate-800">{ data.SMTP.OutboxLastErrorLabel }</td>
						<td class="py-2 break-all text-slate-600">{ data.SMTP.OutboxLastError }</td>
					</tr>
					<tr class="align-top">
						<td class="py-2 pr-3 font-medium text-slate-800">{ data.SMTP.OutboxAttemptsLabel }</td>
						<td class="py-2 text-slate-600">{ data.SMTP.OutboxAttempts }</td>
					</tr>
				</tbody>
			</table>
		</section>
	}
}
