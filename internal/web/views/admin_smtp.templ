package views

// adminSMTP 渲染 SMTP 配置页（M1-17）：传输参数、口令配置状态、「测试连接」按钮与结果，
// 以及 outbox 队列表的读数（是否已配置、待投递/失败计数、最后一次错误与尝试次数）。
// 文案全部来自 AdminPageData.SMTP。
templ adminSMTP(data AdminPageData) {
	if data.SMTP != nil {
		<div class="space-y-8">
			<form class="space-y-5" method="post" action={ data.SMTP.FormAction }>
				<input type="hidden" name="csrf_token" value={ data.SMTP.CSRF }/>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
					<label class="block sm:col-span-2">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.HostLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="smtp_host" value={ data.SMTP.HostValue }/>
						<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.HostHint }</span>
						<span class="mt-0.5 block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">{ data.SMTP.HostSource }</span>
					</label>
					<label class="block sm:col-span-1">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.PortLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 font-mono shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="smtp_port" value={ data.SMTP.PortValue }/>
						<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.PortHint }</span>
						<span class="mt-0.5 block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">{ data.SMTP.PortSource }</span>
					</label>
				</div>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.UsernameLabel }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="smtp_username" value={ data.SMTP.UsernameValue }/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.UsernameHint }</span>
					<span class="mt-0.5 block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">{ data.SMTP.UsernameSource }</span>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.PasswordLabel }</span>
					<span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400 font-medium">{ data.SMTP.PasswordStatus }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="password" name="smtp_password" value="" autocomplete="new-password"/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.PasswordHint }</span>
					<span class="mt-0.5 block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">{ data.SMTP.PasswordSource }</span>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.FromLabel }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="smtp_from" value={ data.SMTP.FromValue }/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.FromHint }</span>
					<span class="mt-0.5 block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">{ data.SMTP.FromSource }</span>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.SMTP.TLSModeLabel }</span>
					<select class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors cursor-pointer" name="smtp_tls_mode">
						for _, opt := range data.SMTP.TLSModeOptions {
							<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
						}
					</select>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.SMTP.TLSModeHint }</span>
				</label>
				<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.SMTP.SaveLabel }</button>
			</form>

			<div class="pt-4 border-t border-zinc-100 dark:border-zinc-800 space-y-3">
				<form method="post" action={ data.SMTP.TestAction }>
					<input type="hidden" name="csrf_token" value={ data.SMTP.CSRF }/>
					<input type="hidden" name="smtp_host" value={ data.SMTP.HostValue }/>
					<input type="hidden" name="smtp_port" value={ data.SMTP.PortValue }/>
					<input type="hidden" name="smtp_username" value={ data.SMTP.UsernameValue }/>
					<input type="hidden" name="smtp_from" value={ data.SMTP.FromValue }/>
					<input type="hidden" name="smtp_tls_mode" value={ data.SMTP.TLSModeValue }/>
					<button class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.SMTP.TestLabel }</button>
				</form>
				if data.SMTP.TestResult != "" {
					if data.SMTP.TestOK {
						<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 shadow-xs">{ data.SMTP.TestResult }</div>
					} else {
						<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs">{ data.SMTP.TestResult }</div>
					}
				}
			</div>

			<section class="space-y-4 pt-6 border-t border-zinc-100 dark:border-zinc-800">
				<div>
					<h2 class="text-base font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.SMTP.OutboxHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.SMTP.OutboxIntro }</p>
				</div>
				<div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
					<table class="w-full text-left text-sm">
						<tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100 w-1/3">{ data.SMTP.OutboxConfiguredLabel }</td>
								<td class="px-5 py-3.5 text-zinc-600 dark:text-zinc-400">{ data.SMTP.OutboxConfiguredStatus }</td>
							</tr>
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100">{ data.SMTP.OutboxPendingLabel }</td>
								<td class="px-5 py-3.5 font-mono text-zinc-600 dark:text-zinc-400">{ data.SMTP.OutboxPending }</td>
							</tr>
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100">{ data.SMTP.OutboxFailedLabel }</td>
								<td class="px-5 py-3.5 font-mono text-zinc-600 dark:text-zinc-400">{ data.SMTP.OutboxFailed }</td>
							</tr>
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100">{ data.SMTP.OutboxLastErrorLabel }</td>
								<td class="px-5 py-3.5 font-mono text-xs text-zinc-600 dark:text-zinc-400 break-all">{ data.SMTP.OutboxLastError }</td>
							</tr>
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100">{ data.SMTP.OutboxAttemptsLabel }</td>
								<td class="px-5 py-3.5 font-mono text-zinc-600 dark:text-zinc-400">{ data.SMTP.OutboxAttempts }</td>
							</tr>
							<tr class="align-top">
								<td class="px-5 py-3.5 font-semibold text-zinc-950 dark:text-zinc-100">{ data.SMTP.AdminNotifyLabel }</td>
								<td class="px-5 py-3.5 text-zinc-600 dark:text-zinc-400">{ data.SMTP.AdminNotifyStatus }</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</div>
	}
}
