package views

// DeckSettingsPage 是卡组设置页（仅 owner）：编辑每日新卡 / 复习上限，并显示今日已用与剩余。
//
// 今日数字由 handler 从 schedule.DeckBudgets 取好传入（与复习队列同源），模板不读库、
// 不算额度公式，因此页面上看到的剩余与点进复习能刷的张数一致。
templ DeckSettingsPage(data DeckSettingsData) {
	@Base(data.Layout) {
		<div class="space-y-8">
			<div class="space-y-1">
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.Heading }</h1>
				<p class="text-sm text-zinc-500 dark:text-zinc-400">
					<a class="font-medium text-zinc-950 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" href={ data.BackHref }>{ data.BackLabel }</a>
					<span class="font-semibold">{ data.DeckName }</span>
				</p>
			</div>

			// 保存成功提示（POST 后 303 回带 ?notice=）。校验失败时这里为空。
			if data.Notice != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 shadow-xs" role="status">{ data.Notice }</div>
			}
			// 校验失败就地渲染 400，不写库。
			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">{ data.ErrorMessage }</div>
			}

			<!-- 每日上限编辑表单 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
				<form class="space-y-4" method="post" action={ data.Action }>
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.NewPerDayLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="number" min="0" name="new_per_day" value={ data.NewPerDayValue } required/>
					</label>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.ReviewsPerDayLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="number" min="0" name="reviews_per_day" value={ data.ReviewsPerDayValue } required/>
					</label>
					<p class="text-xs text-zinc-500 dark:text-zinc-400">{ data.UnlimitedHint }</p>
					<div class="pt-2">
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.SubmitLabel }</button>
					</div>
				</form>
			</section>

			<!-- 今日额度：已用与剩余，与复习队列同源 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
				<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.UsageHeading }</h2>
				<dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
					<div class="rounded-xl border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/50 p-4">
						<dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.NewUsedLabel }</dt>
						<dd class="mt-1 text-base font-bold font-mono text-zinc-950 dark:text-zinc-100">{ data.NewUsedValue }</dd>
					</div>
					<div class="rounded-xl border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/50 p-4">
						<dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.NewLeftLabel }</dt>
						<dd class="mt-1 text-base font-bold font-mono text-zinc-950 dark:text-zinc-100">{ data.NewLeftValue }</dd>
					</div>
					<div class="rounded-xl border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/50 p-4">
						<dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.ReviewUsedLabel }</dt>
						<dd class="mt-1 text-base font-bold font-mono text-zinc-950 dark:text-zinc-100">{ data.ReviewUsedValue }</dd>
					</div>
					<div class="rounded-xl border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/50 p-4">
						<dt class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.ReviewLeftLabel }</dt>
						<dd class="mt-1 text-base font-bold font-mono text-zinc-950 dark:text-zinc-100">{ data.ReviewLeftValue }</dd>
					</div>
				</dl>
			</section>
		</div>
	}
}