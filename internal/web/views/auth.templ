package views

// AuthPage 渲染登录、注册与首次管理员引导共用的表单页。
// 页面上的每一个字符串都来自 AuthFormData，因此模板本身不含任何硬编码用户文案。
templ AuthPage(data AuthFormData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-md py-6 sm:py-10 space-y-6">
			<div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
				<div class="space-y-2 text-center">
					<div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-zinc-950 text-white shadow-xs dark:bg-zinc-100 dark:text-zinc-950">
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m9 12 2 2 4-4"></path></svg>
					</div>
					<h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.Heading }</h1>
					if data.Intro != "" {
						<p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">{ data.Intro }</p>
					}
				</div>

				if data.ErrorMessage != "" {
					<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">
						{ data.ErrorMessage }
					</div>
				}

				<form class="space-y-4" method="post" action={ data.Action }>
					if data.CSRF != "" {
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					}
					if data.InviteToken != "" {
						<input type="hidden" name="invite" value={ data.InviteToken }/>
					}
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.UsernameLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="username" autocomplete="username" required/>
					</label>
					if data.ShowEmail {
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.EmailLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="email" name="email" autocomplete="email" value={ data.EmailValue } required/>
						</label>
					}
					if data.ShowDisplayName {
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.DisplayNameLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="display_name" autocomplete="name"/>
						</label>
					}
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.PasswordLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="password" name="password" autocomplete={ data.PasswordAutocomplete } required/>
					</label>
					<button class="inline-flex w-full items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">
						{ data.SubmitLabel }
					</button>
				</form>

				if data.AltHref != "" {
					<div class="text-center pt-2">
						<a class="text-xs sm:text-sm font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors" href={ data.AltHref }>{ data.AltLabel }</a>
					</div>
				}

				if data.OIDCEnabled {
					<div class="border-t border-zinc-100 dark:border-zinc-800 pt-5">
						<a class="inline-flex w-full items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors" href={ data.OIDCHref }>
							<svg class="mr-2 h-4 w-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
							{ data.OIDCLabel }
						</a>
					</div>
				}
			</div>
		</div>
	}
}
