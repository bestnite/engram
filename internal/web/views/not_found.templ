package views

// NotFound 是未知路径回退页：居中的错误卡片加一个回首页入口，复用通用外壳 Base。
templ NotFound(data NotFoundData) {
	@Base(data.Layout) {
		<div class="mx-auto flex max-w-2xl flex-col items-center justify-center py-16 sm:py-24 text-center">
			<div class="w-full overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-8 sm:p-12 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
				<span class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-zinc-100 text-zinc-400 dark:bg-zinc-800 dark:text-zinc-500">
					<svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="M8 11h6"></path></svg>
				</span>
				<p class="mt-6 text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.Code }</p>
				<h1 class="mt-2 text-xl font-semibold text-zinc-900 dark:text-zinc-100">{ data.Heading }</h1>
				<p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{ data.Message }</p>
				<a class="mt-8 inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all" href={ data.HomeHref }>{ data.HomeLabel }</a>
			</div>
		</div>
	}
}
