package views

// StatsPage 是统计页（M7-3，DESIGN.md §8.1、§9）。
//
// 图表刻意只用 HTML + CSS 柱状条：不引任何图表库、不引 CDN，因此页面渲染时零外部网络
// 请求（M7-3 验收）。柱宽由 handler 算好后放进 WidthCSS，模板不自己算比例。
// 模板不含任何硬编码文案，全部文字来自 data 字段（AGENTS.md §2.1）。
templ StatsPage(data StatsData) {
	@Base(data.Layout) {
		<div class="space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
				<p class="mt-1 text-sm text-zinc-600 leading-relaxed">{ data.Intro }</p>
			</div>

			if data.Empty != "" {
				<div class="rounded-2xl border border-zinc-200/80 bg-white p-12 text-center shadow-xs">
					<p class="text-sm font-medium text-zinc-500">{ data.Empty }</p>
				</div>
			} else {
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					@statsBars(data.VolumeHeading, data.VolumeRows)
					@statsBars(data.DueHeading, data.DueRows)
				</div>

				<!-- 留存率 -->
				<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-xs space-y-4">
					<div>
						<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.RetentionHeading }</h2>
						<p class="mt-0.5 text-xs text-zinc-400">{ data.RetentionIntro }</p>
					</div>
					@statsBarList(data.RetentionRows)
				</section>

				<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
					@statsBars(data.TimeHeading, data.TimeRows)
					@statsBars(data.StreakHeading, data.StreakRows)
					@statsBars(data.GradeHeading, data.GradeRows)
				</div>

				<!-- 学习曲线 -->
				<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-xs space-y-4">
					<div>
						<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.CurveHeading }</h2>
						<p class="mt-0.5 text-xs text-zinc-400">{ data.CurveIntro }</p>
					</div>
					if len(data.CurveRows) == 0 {
						<p class="text-xs text-zinc-400">{ data.CurveEmpty }</p>
					} else {
						<ul class="space-y-3">
							for _, row := range data.CurveRows {
								<li class="rounded-xl border border-zinc-100 bg-zinc-50/50 p-3 space-y-2">
									<div class="text-xs font-semibold font-mono text-zinc-700">{ row.Day }</div>
									<div class="flex items-center gap-3">
										<span class="w-16 shrink-0 text-xs font-medium text-zinc-500">{ data.CurveNewLabel }</span>
										<div class="h-2 flex-1 rounded-full bg-zinc-200/80 overflow-hidden">
											<div class="h-full rounded-full bg-indigo-600" style={ templ.SafeCSS(row.NewWidthCSS) }></div>
										</div>
										<span class="w-12 shrink-0 text-right font-mono text-xs font-semibold text-zinc-900">{ row.NewValue }</span>
									</div>
									<div class="flex items-center gap-3">
										<span class="w-16 shrink-0 text-xs font-medium text-zinc-500">{ data.CurveReviewLabel }</span>
										<div class="h-2 flex-1 rounded-full bg-zinc-200/80 overflow-hidden">
											<div class="h-full rounded-full bg-emerald-600" style={ templ.SafeCSS(row.ReviewWidthCSS) }></div>
										</div>
										<span class="w-12 shrink-0 text-right font-mono text-xs font-semibold text-zinc-900">{ row.ReviewValue }</span>
									</div>
								</li>
							}
						</ul>
					}
				</section>

				<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
					@statsTable(data.DeckHeading, data.DeckEmpty, data.DeckColumns, data.DeckRows)
					@statsTable(data.TagHeading, data.TagEmpty, data.TagColumns, data.TagRows)
				</div>
			}
		</div>
	}
}

// statsBars 渲染一节「标题 + 柱状条行」。
templ statsBars(heading string, rows []StatsRow) {
	<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-xs space-y-4">
		<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ heading }</h2>
		@statsBarList(rows)
	</section>
}

// statsBarList 渲染一组柱状条行；WidthCSS 为空时只显示数字，不画柱。
templ statsBarList(rows []StatsRow) {
	<ul class="space-y-3">
		for _, row := range rows {
			<li>
				<div class="flex items-center justify-between text-xs sm:text-sm">
					<span class="font-medium text-zinc-700">{ row.Label }</span>
					<span class="font-mono font-semibold text-zinc-950">{ row.Value }</span>
				</div>
				if row.WidthCSS != "" {
					<div class="mt-1.5 h-2 rounded-full bg-zinc-100 overflow-hidden">
						<div class="h-full rounded-full bg-indigo-600" style={ templ.SafeCSS(row.WidthCSS) }></div>
					</div>
				}
			</li>
		}
	</ul>
}

// statsTable 渲染一张纯数字表（卡组维度 / 标签维度）。
templ statsTable(heading, empty string, columns []string, rows [][]string) {
	<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white shadow-xs">
		<div class="border-b border-zinc-100 p-5">
			<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ heading }</h2>
		</div>
		if len(rows) == 0 {
			<div class="p-8 text-center text-xs text-zinc-400">{ empty }</div>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-zinc-100 bg-zinc-50/70 text-xs font-semibold uppercase tracking-wider text-zinc-500">
						<tr>
							for _, col := range columns {
								<th class="px-5 py-3 font-semibold">{ col }</th>
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-zinc-100">
						for _, row := range rows {
							<tr class="hover:bg-zinc-50/60 transition-colors">
								for idx, cell := range row {
									if idx == 0 {
										<td class="px-5 py-3.5 font-medium text-zinc-950">{ cell }</td>
									} else {
										<td class="px-5 py-3.5 font-mono text-zinc-600">{ cell }</td>
									}
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
