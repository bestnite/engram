package views

// StatsPage 是统计页（M7-3，DESIGN.md §8.1、§9）。
//
// 图表刻意只用 HTML + CSS 柱状条：不引任何图表库、不引 CDN，因此页面渲染时零外部网络
// 请求（M7-3 验收）。柱宽由 handler 算好后放进 WidthCSS，模板不自己算比例。
// 模板不含任何硬编码文案，全部文字来自 data 字段（AGENTS.md §2.1）。
templ StatsPage(data StatsData) {
	@Base(data.Layout) {
		<h1 class="text-2xl font-bold text-slate-900">{ data.Heading }</h1>
		<p class="mt-2 text-slate-600">{ data.Intro }</p>
		if data.Empty != "" {
			<p class="mt-6 rounded-lg border border-slate-200 bg-white p-4 text-slate-600">{ data.Empty }</p>
		} else {
			@statsBars(data.VolumeHeading, data.VolumeRows)
			@statsBars(data.DueHeading, data.DueRows)
			<section class="mt-8">
				<h2 class="text-sm font-semibold text-slate-500">{ data.RetentionHeading }</h2>
				<p class="mt-1 text-xs text-slate-400">{ data.RetentionIntro }</p>
				@statsBarList(data.RetentionRows)
			</section>
			@statsBars(data.TimeHeading, data.TimeRows)
			@statsBars(data.StreakHeading, data.StreakRows)
			@statsBars(data.GradeHeading, data.GradeRows)
			<section class="mt-8">
				<h2 class="text-sm font-semibold text-slate-500">{ data.CurveHeading }</h2>
				<p class="mt-1 text-xs text-slate-400">{ data.CurveIntro }</p>
				if len(data.CurveRows) == 0 {
					<p class="mt-3 text-slate-600">{ data.CurveEmpty }</p>
				} else {
					<ul class="mt-3 space-y-3">
						for _, row := range data.CurveRows {
							<li>
								<div class="text-xs text-slate-500">{ row.Day }</div>
								<div class="mt-1 flex items-center gap-2">
									<span class="w-20 shrink-0 text-xs text-slate-500">{ data.CurveNewLabel }</span>
									<span class="h-2 flex-1 rounded bg-slate-200">
										<span class="block h-2 rounded bg-blue-600" style={ templ.SafeCSS(row.NewWidthCSS) }></span>
									</span>
									<span class="w-10 shrink-0 text-right text-xs text-slate-700">{ row.NewValue }</span>
								</div>
								<div class="mt-1 flex items-center gap-2">
									<span class="w-20 shrink-0 text-xs text-slate-500">{ data.CurveReviewLabel }</span>
									<span class="h-2 flex-1 rounded bg-slate-200">
										<span class="block h-2 rounded bg-emerald-600" style={ templ.SafeCSS(row.ReviewWidthCSS) }></span>
									</span>
									<span class="w-10 shrink-0 text-right text-xs text-slate-700">{ row.ReviewValue }</span>
								</div>
							</li>
						}
					</ul>
				}
			</section>
			@statsTable(data.DeckHeading, data.DeckEmpty, data.DeckColumns, data.DeckRows)
			@statsTable(data.TagHeading, data.TagEmpty, data.TagColumns, data.TagRows)
		}
	}
}

// statsBars 渲染一节「标题 + 柱状条行」。
templ statsBars(heading string, rows []StatsRow) {
	<section class="mt-8">
		<h2 class="text-sm font-semibold text-slate-500">{ heading }</h2>
		@statsBarList(rows)
	</section>
}

// statsBarList 渲染一组柱状条行；WidthCSS 为空时只显示数字，不画柱。
templ statsBarList(rows []StatsRow) {
	<ul class="mt-3 space-y-2">
		for _, row := range rows {
			<li>
				<div class="flex justify-between text-sm text-slate-700">
					<span>{ row.Label }</span>
					<span class="font-medium">{ row.Value }</span>
				</div>
				if row.WidthCSS != "" {
					<div class="mt-1 h-2 rounded bg-slate-200">
						<div class="h-2 rounded bg-blue-600" style={ templ.SafeCSS(row.WidthCSS) }></div>
					</div>
				}
			</li>
		}
	</ul>
}

// statsTable 渲染一张纯数字表（卡组维度 / 标签维度）。
templ statsTable(heading, empty string, columns []string, rows [][]string) {
	<section class="mt-8">
		<h2 class="text-sm font-semibold text-slate-500">{ heading }</h2>
		if len(rows) == 0 {
			<p class="mt-3 text-slate-600">{ empty }</p>
		} else {
			<table class="mt-3 w-full text-left text-sm">
				<thead class="border-b border-slate-200 text-slate-500">
					<tr>
						for _, col := range columns {
							<th class="py-2">{ col }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="border-b border-slate-100">
							for _, cell := range row {
								<td class="py-2">{ cell }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}