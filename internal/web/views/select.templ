package views

// Select 是通用自定义下拉菜单组件。
templ Select(props SelectProps) {
	<div class={ selectWrapperClass(props.Class) } data-custom-select>
		<input type="hidden" name={ props.Name } id={ props.ID } value={ selectInitialValue(props) } { props.Attrs... }/>
		if props.Small {
			<button type="button" class="flex w-full items-center justify-between gap-1.5 rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs text-zinc-900 shadow-2xs transition-colors hover:border-zinc-300 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-zinc-600 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 cursor-pointer" aria-haspopup="listbox" aria-expanded="false" data-select-trigger>
				<span class="truncate" data-select-label>{ selectDisplayLabel(props) }</span>
				<svg class="chevron h-3.5 w-3.5 shrink-0 text-zinc-400 transition-transform duration-150" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path></svg>
			</button>
		} else {
			<button type="button" class="mt-1.5 flex w-full items-center justify-between gap-2 rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs transition-colors hover:border-zinc-300 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-zinc-600 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 cursor-pointer" aria-haspopup="listbox" aria-expanded="false" data-select-trigger>
				<span class="truncate" data-select-label>{ selectDisplayLabel(props) }</span>
				<svg class="chevron h-4 w-4 shrink-0 text-zinc-400 transition-transform duration-150" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path></svg>
			</button>
		}
		<div class="dropdown-menu absolute left-0 z-50 mt-1 hidden w-full min-w-36 rounded-xl border border-zinc-200/90 bg-white/95 p-1 shadow-xl shadow-zinc-900/10 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95 dark:shadow-black/30" data-select-menu>
			<ul role="listbox" class="max-h-60 overflow-y-auto space-y-0.5" tabindex="-1">
				for _, opt := range props.Options {
					if opt.Value == selectInitialValue(props) {
						<li role="option" data-value={ opt.Value } aria-selected="true" class="select-option select-option-active flex cursor-pointer items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors">
							<span class="truncate">{ opt.Label }</span>
							<svg class="check-icon h-4 w-4 shrink-0 text-zinc-950 dark:text-zinc-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
						</li>
					} else {
						<li role="option" data-value={ opt.Value } aria-selected="false" class="select-option flex cursor-pointer items-center justify-between rounded-lg px-3 py-2 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800/80 dark:hover:text-zinc-100 transition-colors">
							<span class="truncate">{ opt.Label }</span>
							<svg class="check-icon hidden h-4 w-4 shrink-0 text-zinc-950 dark:text-zinc-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
						</li>
					}
				}
			</ul>
		</div>
	</div>
}
