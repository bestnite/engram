package views

// MediaPickerPanel 是编辑页上的「从媒体库选择」入口：点击后用 htmx 拉取片段填进
// MediaPickerListID 容器，避免整页刷新（M2-9 的媒体面上新增的第二个入口）。
// 所有用户可见文案来自语言包；无内联脚本、无 hx-on——副作用在 media.js 里做事件委托。
templ MediaPickerPanel(data MediaPickerData) {
	if !data.Disabled {
		<div class="mt-4" data-media-picker>
			<button class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer" type="button" hx-get={ data.URL } hx-target={ "#" + MediaPickerListID } hx-swap="outerHTML">{ data.OpenLabel }</button>
			<div id={ MediaPickerListID }></div>
		</div>
	}
}

// MediaPickerFragment 是选择器片段：htmx 局部拉取时不带整页外壳。
// 缩略预览直接用原图（服务端不压缩、不重编码），由 CSS 限尺寸与 loading="lazy" 承担成本。
// 每项是普通的 data-media-insert 按钮；插入逻辑在 media.js 里复用已有的 insertRef。
templ MediaPickerFragment(data MediaPickerFragmentData) {
	<div id={ MediaPickerListID } class="mt-3 rounded-2xl border border-zinc-200/80 bg-white p-4 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
		<p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.Heading }</p>
		if len(data.Items) == 0 {
			<p class="mt-2 text-xs text-zinc-400 dark:text-zinc-500">{ data.Empty }</p>
		} else {
			<div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4">
				for _, item := range data.Items {
					<button class="overflow-hidden rounded-lg border border-zinc-200 bg-zinc-50 shadow-2xs hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-800 transition-colors cursor-pointer" type="button" data-media-insert={ item.InsertURL } title={ item.Sha256 }>
						<img class="h-20 w-full object-cover" src={ item.Src } alt={ item.Sha256 } loading="lazy"/>
					</button>
				}
			</div>
			if data.NextURL != "" {
				<div class="mt-3 flex justify-end">
					<button class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer" type="button" hx-get={ data.NextURL } hx-target={ "#" + MediaPickerListID } hx-swap="outerHTML">{ data.NextLabel }</button>
				</div>
			}
		}
	</div>
}
