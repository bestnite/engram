package views

// adminOIDC 渲染 OIDC 配置页（M6-4）：启用开关、issuer / client id / secret、claim 映射、
// 测试连接按钮，以及已绑定身份列表与解绑入口。文案全部来自 AdminPageData.OIDC。
templ adminOIDC(data AdminPageData) {
	if data.OIDC != nil {
		<div class="space-y-8">
			<form class="space-y-5" method="post" action={ data.OIDC.FormAction }>
				<input type="hidden" name="csrf_token" value={ data.OIDC.CSRF }/>
				<label class="flex items-start gap-3 rounded-xl border border-zinc-200/80 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-800/40 p-4 cursor-pointer">
					<input class="mt-1 h-4 w-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900" type="checkbox" name="oidc.enabled" checked?={ data.OIDC.Enabled }/>
					<span class="space-y-0.5">
						<span class="block text-sm font-semibold text-zinc-950 dark:text-zinc-100">{ data.OIDC.EnabledLabel }</span>
						<span class="block text-xs text-zinc-500 dark:text-zinc-400">{ data.OIDC.EnabledHint }</span>
					</span>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.IssuerLabel }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.issuer" value={ data.OIDC.IssuerValue }/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.OIDC.IssuerHint }</span>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.ClientIDLabel }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.client_id" value={ data.OIDC.ClientIDValue }/>
				</label>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.SecretLabel }</span>
					<span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400 font-medium">{ data.OIDC.SecretStatus }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="password" name="oidc.client_secret" value="" autocomplete="new-password"/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.OIDC.SecretHint }</span>
				</label>
				// 回调地址只读展示：值与登录流程共用 oidcRedirectURI()，所以页面上看到的
				// 就是实际会发出去的 redirect_uri。select-all 让一次点击选中整串便于复制。
				<div class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.RedirectURILabel }</span>
					<code class="mt-1.5 block w-full rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-2.5 text-xs font-mono text-zinc-800 break-all select-all dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-200">{ data.OIDC.RedirectURI }</code>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.OIDC.RedirectURIHint }</span>
				</div>
				<label class="block">
					<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.ScopesLabel }</span>
					<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.scopes" value={ data.OIDC.ScopesValue }/>
					<span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-500">{ data.OIDC.ScopesHint }</span>
				</label>
				<fieldset class="rounded-2xl border border-zinc-200/80 bg-zinc-50/40 dark:border-zinc-800 dark:bg-zinc-800/30 p-5 space-y-4">
					<legend class="px-1 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OIDC.ClaimHeading }</legend>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<label class="block">
							<span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">{ data.OIDC.ClaimSubjectLabel }</span>
							<input class="mt-1 w-full rounded-xl border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.claim.subject" value={ data.OIDC.ClaimSubjectValue }/>
						</label>
						<label class="block">
							<span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">{ data.OIDC.ClaimEmailLabel }</span>
							<input class="mt-1 w-full rounded-xl border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.claim.email" value={ data.OIDC.ClaimEmailValue }/>
						</label>
						<label class="block">
							<span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">{ data.OIDC.ClaimNameLabel }</span>
							<input class="mt-1 w-full rounded-xl border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.claim.name" value={ data.OIDC.ClaimNameValue }/>
						</label>
						<label class="block">
							<span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">{ data.OIDC.ClaimEmailVerifiedLabel }</span>
							<input class="mt-1 w-full rounded-xl border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type="text" name="oidc.claim.email_verified" value={ data.OIDC.ClaimEmailVerifiedValue }/>
						</label>
					</div>
				</fieldset>
				<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.OIDC.SaveLabel }</button>
			</form>

			<div class="pt-4 border-t border-zinc-100 dark:border-zinc-800 space-y-3">
				<form method="post" action={ data.OIDC.TestAction }>
					<input type="hidden" name="csrf_token" value={ data.OIDC.CSRF }/>
					<input type="hidden" name="oidc.issuer" value={ data.OIDC.IssuerValue }/>
					<input type="hidden" name="oidc.client_id" value={ data.OIDC.ClientIDValue }/>
					<input type="hidden" name="oidc.scopes" value={ data.OIDC.ScopesValue }/>
					<button class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.OIDC.TestLabel }</button>
				</form>
				if data.OIDC.TestResult != "" {
					if data.OIDC.TestOK {
						<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 shadow-xs">{ data.OIDC.TestResult }</div>
					} else {
						<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs">{ data.OIDC.TestResult }</div>
					}
				}
			</div>

			<section class="space-y-4 pt-6 border-t border-zinc-100 dark:border-zinc-800">
				<div>
					<h2 class="text-base font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.OIDC.IdentitiesHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.OIDC.IdentitiesIntro }</p>
				</div>
				if len(data.OIDC.Identities) == 0 {
					<div class="p-8 text-center text-xs text-zinc-400 dark:text-zinc-500">{ data.OIDC.IdentitiesEmpty }</div>
				} else {
					<div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
						<table class="w-full text-left text-sm">
							<thead class="border-b border-zinc-200/80 bg-zinc-50/70 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:border-zinc-800 dark:bg-zinc-800/60 dark:text-zinc-400">
								<tr>
									<th class="px-4 py-3 font-semibold">{ data.OIDC.ColProvider }</th>
									<th class="px-4 py-3 font-semibold">{ data.OIDC.ColSubject }</th>
									<th class="px-4 py-3 font-semibold">{ data.OIDC.ColEmail }</th>
									<th class="px-4 py-3 font-semibold">{ data.OIDC.ColUser }</th>
									<th class="px-4 py-3 font-semibold">{ data.OIDC.ColLinked }</th>
									<th class="px-4 py-3 font-semibold text-right">{ data.OIDC.ColActions }</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
								for _, row := range data.OIDC.Identities {
									<tr class="hover:bg-zinc-50/60 dark:hover:bg-zinc-800/50 transition-colors align-top">
										<td class="px-4 py-3 text-xs font-mono text-zinc-700 dark:text-zinc-300 break-all">{ row.Provider }</td>
										<td class="px-4 py-3 text-xs font-mono text-zinc-700 dark:text-zinc-300 break-all">{ row.Subject }</td>
										<td class="px-4 py-3 text-xs text-zinc-600 dark:text-zinc-400">{ row.Email }</td>
										<td class="px-4 py-3 text-xs font-semibold text-zinc-950 dark:text-zinc-100">{ row.Username }</td>
										<td class="px-4 py-3 text-xs font-mono text-zinc-400 dark:text-zinc-500 whitespace-nowrap">{ row.LinkedAt }</td>
										<td class="px-4 py-3 text-right">
											<form method="post" action={ row.UnlinkHref }>
												<input type="hidden" name="csrf_token" value={ data.OIDC.CSRF }/>
												<button class="inline-flex items-center rounded-lg border border-rose-200 bg-white px-2.5 py-1 text-xs font-medium text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-900/60 transition-colors cursor-pointer" type="submit">{ data.OIDC.UnlinkLabel }</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}
