package views

// MailPrefsPage 是邮件偏好页（M1-18）：登录用户看到四类邮件开关，A 类不可关闭。
// 所有文案与值都来自 MailPrefsData，模板内不写死任何面向用户的文字。
templ MailPrefsPage(data MailPrefsData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-3xl space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
				<p class="mt-1 text-sm text-zinc-600 leading-relaxed">{ data.Intro }</p>
			</div>

			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs" role="alert">{ data.ErrorMessage }</div>
			}
			if data.SavedMessage != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-xs" role="status">{ data.SavedMessage }</div>
			}

			<form class="space-y-6" method="post" action="/settings/notifications">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				for _, group := range data.Groups {
					<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-4">
						<div>
							<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ group.Heading }</h2>
							<p class="mt-1 text-xs text-zinc-500">{ group.Note }</p>
						</div>
						<ul class="divide-y divide-zinc-100">
							for _, item := range group.Types {
								<li class="py-3.5 flex items-start gap-3.5 first:pt-0 last:pb-0">
									if item.Locked {
										<input class="mt-1 h-4 w-4 rounded border-zinc-300 text-zinc-400 bg-zinc-100 cursor-not-allowed" type="checkbox" checked disabled/>
									} else {
										<input class="mt-1 h-4 w-4 rounded border-zinc-300 text-zinc-950 focus:ring-zinc-900 cursor-pointer" type="checkbox" name={ item.InputName } value="on" checked?={ item.Enabled }/>
									}
									<div class="space-y-0.5">
										<span class="text-sm font-semibold text-zinc-900">{ item.Label }</span>
										if item.Locked {
											<p class="text-xs text-zinc-400">{ item.LockedReason }</p>
										}
									</div>
								</li>
							}
						</ul>
					</section>
				}
				<div class="pt-2">
					<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.SubmitLabel }</button>
				</div>
			</form>
		</div>
	}
}
