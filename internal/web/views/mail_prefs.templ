package views

// MailPrefsPage 是邮件偏好页（M1-18）：登录用户看到四类邮件开关，A 类不可关闭。
// 所有文案与值都来自 MailPrefsData，模板内不写死任何面向用户的文字。
templ MailPrefsPage(data MailPrefsData) {
	@Base(data.Layout) {
		<h1 class="text-2xl font-semibold">{ data.Heading }</h1>
		<p class="mt-2 text-sm text-slate-600">{ data.Intro }</p>
		if data.ErrorMessage != "" {
			<p class="mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ data.ErrorMessage }</p>
		}
		if data.SavedMessage != "" {
			<p class="mt-4 rounded border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700" role="status">{ data.SavedMessage }</p>
		}

		<form class="mt-8 space-y-6" method="post" action="/settings/notifications">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			for _, group := range data.Groups {
				<section class="rounded border border-slate-200 bg-white p-4">
					<h2 class="text-lg font-semibold">{ group.Heading }</h2>
					<p class="mt-1 text-xs text-slate-500">{ group.Note }</p>
					<ul class="mt-4 space-y-3">
						for _, item := range group.Types {
							<li class="flex items-start gap-3">
								if item.Locked {
									<input class="mt-1" type="checkbox" checked disabled/>
								} else {
									<input class="mt-1" type="checkbox" name={ item.InputName } value="on" checked?={ item.Enabled }/>
								}
								<div>
									<span class="text-sm font-medium">{ item.Label }</span>
									if item.Locked {
										<p class="text-xs text-slate-500">{ item.LockedReason }</p>
									}
								</div>
							</li>
						}
					</ul>
				</section>
			}
			<button class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white" type="submit">{ data.SubmitLabel }</button>
		</form>
	}
}