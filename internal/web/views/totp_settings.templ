package views

// TOTPSettingsPage 是个人设置页里的 TOTP 区块（/settings/totp，M1-16）。
// 页面上的每一个字符串都来自 TOTPSettingsData，模板本身不含任何硬编码用户文案。
templ TOTPSettingsPage(data TOTPSettingsData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-3xl space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
				<p class="mt-1 text-sm text-zinc-600 leading-relaxed">{ data.Intro }</p>
			</div>

			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs" role="alert">{ data.ErrorMessage }</div>
			}
			if data.SavedMessage != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-xs" role="status">{ data.SavedMessage }</div>
			}

			<div class="flex items-center gap-2">
				if data.Enabled {
					<span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-600/20">{ data.StatusEnabledLabel }</span>
				} else {
					<span class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-semibold text-zinc-600">{ data.StatusDisabledLabel }</span>
				}
			</div>

			if !data.Enabled {
				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-4">
					<form method="post" action="/settings/totp/begin">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<p class="text-sm text-zinc-600 leading-relaxed">{ data.BeginHint }</p>
						<button class="mt-4 inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.BeginSubmit }</button>
					</form>
				</section>
			}

			if data.Pending {
				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-6">
					<div>
						<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.PendingHeading }</h2>
					</div>
					<div class="rounded-xl border border-zinc-100 bg-zinc-50/70 p-4 space-y-3">
						<div>
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.SecretLabel }</span>
							<p class="mt-1 font-mono text-sm font-semibold text-zinc-900 break-all select-all">{ data.SecretValue }</p>
						</div>
						<div>
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.OtpauthLabel }</span>
							<p class="mt-1 font-mono text-xs text-zinc-600 break-all select-all">{ data.OtpauthURL }</p>
						</div>
					</div>
					<form class="space-y-4" method="post" action="/settings/totp/confirm">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<p class="text-sm text-zinc-600">{ data.ConfirmHint }</p>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.PasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm font-mono text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required/>
						</label>
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.ConfirmSubmit }</button>
					</form>
				</section>
			}

			if data.Enabled {
				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-4">
					<div>
						<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.DisableHeading }</h2>
						<p class="mt-1 text-xs text-zinc-500">{ data.DisableHint }</p>
					</div>
					<form class="space-y-4" method="post" action="/settings/totp/disable">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.PasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="password" name="password" autocomplete="current-password" required/>
						</label>
						<button class="inline-flex items-center justify-center rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 shadow-2xs hover:bg-rose-50 hover:border-rose-300 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.DisableSubmit }</button>
					</form>
				</section>

				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs space-y-4">
					<div>
						<h2 class="text-lg font-bold tracking-tight text-zinc-950">{ data.RecoveryHeading }</h2>
						<p class="mt-1 text-xs text-zinc-500">{ data.RecoveryRemaining }</p>
					</div>
					if data.RecoveryWarning != "" {
						<div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800 shadow-2xs" role="alert">{ data.RecoveryWarning }</div>
					}
					if len(data.RecoveryCodes) > 0 {
						<div class="space-y-2">
							<p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.RecoveryCodesLabel }</p>
							<ul class="grid grid-cols-2 gap-2 font-mono text-xs">
								for _, code := range data.RecoveryCodes {
									<li class="rounded-lg border border-zinc-100 bg-zinc-50 p-2 text-center text-zinc-800 select-all">{ code }</li>
								}
							</ul>
						</div>
					}
					<form class="space-y-4 pt-2" method="post" action="/settings/totp/recovery">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.PasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="password" name="password" autocomplete="current-password" required/>
						</label>
						<button class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.RecoveryRegenSubmit }</button>
					</form>
				</section>
			}
		</div>
	}
}
