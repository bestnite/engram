package views

// TOTPSettingsPage 是个人设置页里的 TOTP 区块（/settings/totp，M1-16）。
// 页面上的每一个字符串都来自 TOTPSettingsData，模板本身不含任何硬编码用户文案。
templ TOTPSettingsPage(data TOTPSettingsData) {
	@Base(data.Layout) {
		<h1 class="text-2xl font-semibold">{ data.Heading }</h1>
		<p class="mt-2 text-sm text-slate-600">{ data.Intro }</p>
		if data.ErrorMessage != "" {
			<p class="mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ data.ErrorMessage }</p>
		}
		if data.SavedMessage != "" {
			<p class="mt-4 rounded border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700" role="status">{ data.SavedMessage }</p>
		}
		<p class="mt-4 text-sm font-medium">
			if data.Enabled {
				{ data.StatusEnabledLabel }
			} else {
				{ data.StatusDisabledLabel }
			}
		</p>

		if !data.Enabled {
			<section class="mt-8 rounded border border-slate-200 bg-white p-4">
				<form method="post" action="/settings/totp/begin">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<p class="text-sm text-slate-600">{ data.BeginHint }</p>
					<button class="mt-4 rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white" type="submit">{ data.BeginSubmit }</button>
				</form>
			</section>
		}

		if data.Pending {
			<section class="mt-8 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-lg font-semibold">{ data.PendingHeading }</h2>
				<dl class="mt-4 space-y-2 text-sm">
					<div>
						<dt class="font-medium">{ data.SecretLabel }</dt>
						<dd class="break-all font-mono">{ data.SecretValue }</dd>
					</div>
					<div>
						<dt class="font-medium">{ data.OtpauthLabel }</dt>
						<dd class="break-all font-mono">{ data.OtpauthURL }</dd>
					</div>
				</dl>
				<form class="mt-4 space-y-2" method="post" action="/settings/totp/confirm">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<p class="text-sm text-slate-600">{ data.ConfirmHint }</p>
					<label class="block">
						<span class="text-sm font-medium text-slate-700">{ data.PasswordLabel }</span>
						<input class="mt-1 w-full rounded border border-slate-300 px-3 py-2" type="text" name="code" inputmode="numeric" autocomplete="one-time-code"/>
					</label>
					<button class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white" type="submit">{ data.ConfirmSubmit }</button>
				</form>
			</section>
		}

		if data.Enabled {
			<section class="mt-8 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-lg font-semibold">{ data.DisableHeading }</h2>
				<p class="mt-2 text-sm text-slate-600">{ data.DisableHint }</p>
				<form class="mt-4 space-y-2" method="post" action="/settings/totp/disable">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-sm font-medium text-slate-700">{ data.PasswordLabel }</span>
						<input class="mt-1 w-full rounded border border-slate-300 px-3 py-2" type="password" name="password" autocomplete="current-password"/>
					</label>
					<button class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white" type="submit">{ data.DisableSubmit }</button>
				</form>
			</section>

			<section class="mt-8 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-lg font-semibold">{ data.RecoveryHeading }</h2>
				<p class="mt-2 text-sm text-slate-600">{ data.RecoveryRemaining }</p>
				if data.RecoveryWarning != "" {
					<p class="mt-2 text-sm text-amber-700" role="alert">{ data.RecoveryWarning }</p>
				}
				if len(data.RecoveryCodes) > 0 {
					<p class="mt-2 text-sm font-medium">{ data.RecoveryCodesLabel }</p>
					<ul class="mt-2 grid grid-cols-2 gap-1 font-mono text-sm">
						for _, code := range data.RecoveryCodes {
							<li>{ code }</li>
						}
					</ul>
				}
				<form class="mt-4 space-y-2" method="post" action="/settings/totp/recovery">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-sm font-medium text-slate-700">{ data.PasswordLabel }</span>
						<input class="mt-1 w-full rounded border border-slate-300 px-3 py-2" type="password" name="password" autocomplete="current-password"/>
					</label>
					<button class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white" type="submit">{ data.RecoveryRegenSubmit }</button>
				</form>
			</section>
		}
	}
}
