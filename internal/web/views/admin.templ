package views

// AdminPage 是管理面板的所有子页共用的外壳（M6-1）：左侧导航 + 内容区。
// 所有文案由 AdminPageData 传入，模板里没有硬编码文字。
templ AdminPage(data AdminPageData) {
	@Base(data.Layout) {
		<h1 class="text-2xl font-bold text-slate-900">{ data.Heading }</h1>
		<p class="mt-2 text-slate-600">{ data.Intro }</p>
		if data.Notice != "" {
			<div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-sm text-blue-800">{ data.Notice }</div>
		}
		<div class="mt-6 flex flex-col gap-8 md:flex-row">
			<nav class="w-full shrink-0 md:w-52">
				<h2 class="text-sm font-semibold text-slate-500">{ data.NavHeading }</h2>
				<ul class="mt-2 space-y-1">
					for _, item := range data.Nav {
						<li>
							if item.Implemented {
								if item.Active {
									<a class="block rounded bg-blue-600 px-3 py-1.5 text-sm font-medium text-white" href={ item.Href }>{ item.Label }</a>
								} else {
									<a class="block rounded px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100" href={ item.Href }>{ item.Label }</a>
								}
							} else {
								<span class="flex items-center gap-2 rounded px-3 py-1.5 text-sm text-slate-400">
									{ item.Label }
									<em class="rounded bg-slate-100 px-1.5 py-0.5 text-xs not-italic text-slate-400">{ item.PendingLabel }</em>
								</span>
							}
						</li>
					}
				</ul>
			</nav>
			<div class="min-w-0 flex-1">
				if data.UsersPage {
					@adminUsers(data)
				} else if data.RegistrationPage {
					@adminRegistration(data)
				} else if data.JobsPage {
					@adminJobs(data)
				} else if data.OIDCPage {
					@adminOIDC(data)
				} else if data.AuditPage {
					@adminAudit(data)
				} else if data.HealthPage {
					@adminHealth(data)
				} else if data.APIKeysPage {
					@adminAPIKeys(data)
				} else {
					if data.ShowForm {
						<form method="post" action={ data.FormAction }>
							<input type="hidden" name="csrf_token" value={ data.CSRF }/>
							@adminSections(data)
							<button class="mt-4 rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" type="submit">{ data.SaveLabel }</button>
						</form>
					} else {
						@adminSections(data)
					}
				}
				if data.ExportHref != "" {
					<section class="mt-8 border-t border-slate-200 pt-6">
						<h2 class="text-sm font-semibold text-slate-500">{ data.ExportHeading }</h2>
						<a class="mt-2 inline-block rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" href={ data.ExportHref }>{ data.ExportLabel }</a>
						<p class="mt-2 text-xs text-slate-400">{ data.ExportHint }</p>
					</section>
				}
			</div>
		</div>
	}
}

// adminSections 渲染设置区块表；每一行标注生效值的来源。
templ adminSections(data AdminPageData) {
	for _, section := range data.Sections {
		<section class="mt-6 first:mt-0">
			<h2 class="text-sm font-semibold text-slate-500">{ section.Heading }</h2>
			if section.Intro != "" {
				<p class="mt-1 text-xs text-slate-400">{ section.Intro }</p>
			}
			<table class="mt-3 w-full text-left text-sm">
				<thead>
					<tr class="border-b border-slate-200 text-xs text-slate-400">
						<th class="py-2 pr-3 font-medium">{ data.Columns.Setting }</th>
						<th class="py-2 pr-3 font-medium">{ data.Columns.Value }</th>
						<th class="py-2 font-medium">{ data.Columns.Source }</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range section.Rows {
						<tr class="border-b border-slate-100 align-top">
							<td class="py-3 pr-3">
								<div class="font-medium text-slate-800">{ row.Label }</div>
								if row.Hint != "" {
									<p class="mt-0.5 text-xs text-slate-400">{ row.Hint }</p>
								}
							</td>
							<td class="py-3 pr-3">
								if row.Sensitive {
									<span class="text-slate-600">{ row.StatusText }</span>
									<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="password" name={ row.Key } value="" autocomplete="new-password"/>
								} else if row.Editable {
									<input class="block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name={ row.Key } value={ row.Value }/>
								} else {
									<span class="break-all text-slate-600">{ row.Value }</span>
								}
							</td>
							<td class="py-3 text-xs text-slate-500">{ row.SourceLabel }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}
