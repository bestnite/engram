package views

// SettingsPage 是个人设置页（M1-8）：显示名、界面语言、时区、复习日切点与改密码。
// 所有文案与值都来自 SettingsData，模板内不写死任何面向用户的文字。
templ SettingsPage(data SettingsData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-3xl space-y-8">
			<div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.Heading }</h1>
				<p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{ data.Intro }</p>
			</div>

			if data.ErrorMessage != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">
					{ data.ErrorMessage }
				</div>
			}
			if data.SavedMessage != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 shadow-xs" role="status">
					{ data.SavedMessage }
				</div>
			}

			<!-- 个人档案设置卡片 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.ProfileHeading }</h2>
				</div>
				<form class="space-y-4" method="post" action="/settings/profile">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.DisplayNameLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" id="settings-display-name" name="display_name" value={ data.DisplayNameValue }/>
					</label>
					@SettingsLocaleControl(data.LocaleLabel, data.LocaleOptions, templ.Attributes{})
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.TimezoneLabel }</span>
						<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" id="settings-timezone" name="timezone" value={ data.TimezoneValue } list="settings-timezone-options"/>
						<datalist id="settings-timezone-options">
							for _, zone := range data.TimezoneOptions {
								<option value={ zone }></option>
							}
						</datalist>
						<p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">{ data.TimezoneHint }</p>
					</label>
					<label class="block">
						<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.CutoffLabel }</span>
						<input class="mt-1.5 w-32 rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 font-mono shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" id="settings-cutoff" name="day_cutoff_hour" type="number" min="1" max="23" value={ data.CutoffValue }/>
						<p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">{ data.CutoffHint }</p>
					</label>
					<div class="pt-2">
						<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.ProfileSubmit }</button>
					</div>
				</form>
			</section>

			<!-- 密码修改卡片 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.PasswordHeading }</h2>
				</div>
				if data.PasswordAvailable {
					<form class="space-y-4" method="post" action="/settings/password">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.OldPasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" id="settings-old-password" name="old_password" type="password" autocomplete="current-password" required/>
						</label>
						<label class="block">
							<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.NewPasswordLabel }</span>
							<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" id="settings-new-password" name="new_password" type="password" autocomplete="new-password" required/>
						</label>
						<p class="text-xs text-zinc-400 dark:text-zinc-500">{ data.PasswordNote }</p>
						<div class="pt-2">
							<button class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.98] transition-all cursor-pointer" type="submit">{ data.PasswordSubmit }</button>
						</div>
					</form>
				} else {
					<p class="text-sm text-zinc-500 dark:text-zinc-400">{ data.PasswordUnavailable }</p>
				}
			</section>

			<!-- 双因子验证卡片 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.TOTPHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.TOTPHint }</p>
				</div>
				<a class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0" href={ data.TOTPHref }>{ data.TOTPLinkLabel }</a>
			</section>

			<!-- 邮件偏好卡片 -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.MailPrefsHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.MailPrefsHint }</p>
				</div>
				<a class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0" href={ data.MailPrefsHref }>{ data.MailPrefsLinkLabel }</a>
			</section>

			<!-- 邮箱地址变更卡片（仅安全邮件栈启用时渲染） -->
			if data.EmailAvailable {
				<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<div>
						<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.EmailHeading }</h2>
						<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.EmailHint }</p>
					</div>
					<a class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0" href={ data.EmailHref }>{ data.EmailLinkLabel }</a>
				</section>
			}

			<!-- API Key 管理卡片（M4-10） -->
			<section class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<div>
					<h2 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">{ data.KeysHeading }</h2>
					<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{ data.KeysHint }</p>
				</div>
				<a class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0" href={ data.KeysHref }>{ data.KeysLinkLabel }</a>
			</section>
		</div>
	}
}

// SettingsLocaleControl 是设置页的语言控件：外层 label 带固定 id，作为 htmx 带外交换
// 的锚点（views.SettingsLocaleControlID）。attrs 用于把 hx-swap-oob 透传到该 label 上，
// 页面内使用时传空值即可。
templ SettingsLocaleControl(label string, options []SelectOption, attrs templ.Attributes) {
	<label id="settings-locale-control" class="block" { attrs... }>
		<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ label }</span>
		@Select(SelectProps{ID: "settings-locale", Name: "locale", Options: options})
	</label>
}
