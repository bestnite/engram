package views

// SecurityPage 渲染密码重置、邮箱验证与改邮箱确认这些安全/事务流程的页面。
// 页面上的每个字符串都来自 SecurityFormData，模板不含任何硬编码用户文案。
templ SecurityPage(data SecurityFormData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-md py-6 sm:py-10 space-y-6">
			<div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-sm space-y-6">
				<div class="space-y-2 text-center">
					<div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-zinc-950 text-white shadow-xs">
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
					</div>
					<h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950">{ data.Heading }</h1>
					if data.Intro != "" {
						<p class="text-xs sm:text-sm text-zinc-500 leading-relaxed">{ data.Intro }</p>
					}
				</div>

				if data.Notice != "" {
					<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-xs" role="status">
						{ data.Notice }
					</div>
				}
				if data.ErrorMessage != "" {
					<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs" role="alert">
						{ data.ErrorMessage }
					</div>
				}

				if data.ShowForm {
					<form class="space-y-4" method="post" action={ data.Action }>
						if data.CSRF != "" {
							<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						}
						if data.ShowEmail {
							<label class="block">
								<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.EmailLabel }</span>
								<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="email" name="email" autocomplete="email" value={ data.EmailValue } required/>
							</label>
						}
						if data.ShowPassword {
							<label class="block">
								<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{ data.PasswordLabel }</span>
								<input class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-3.5 py-2.5 text-sm text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 transition-colors" type="password" name="password" autocomplete="new-password" required/>
							</label>
						}
						<button class="inline-flex w-full items-center justify-center rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-zinc-800 active:scale-[0.98] transition-all cursor-pointer" type="submit">
							{ data.SubmitLabel }
						</button>
					</form>
				}

				if data.AltHref != "" {
					<div class="text-center pt-2">
						<a class="text-xs sm:text-sm font-medium text-zinc-600 hover:text-zinc-950 transition-colors" href={ data.AltHref }>{ data.AltLabel }</a>
					</div>
				}
			</div>

			if len(data.LangOptions) > 0 {
				<div class="flex items-center justify-center">
					<ul class="flex flex-wrap items-center justify-center gap-2">
						for _, l := range data.LangOptions {
							<li>
								if l.Active {
									<span class="inline-flex items-center rounded-lg bg-zinc-950 px-2.5 py-1 text-xs font-semibold text-white shadow-2xs">{ l.Label }</span>
								} else {
									<a class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-600 shadow-2xs hover:bg-zinc-50 hover:text-zinc-950 transition-colors" href={ l.Href }>{ l.Label }</a>
								}
							</li>
						}
					</ul>
				</div>
			}
		</div>
	}
}
