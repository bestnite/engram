package views

// ReviewPage 渲染复习页整页：主区域 + 键盘/滑动交互脚本（M3-5）。
// 模板不含任何硬编码用户文案；可见字符串全部来自 ReviewPageData。
templ ReviewPage(data ReviewPageData) {
	@Base(data.Layout) {
		<div class="mx-auto max-w-2xl">
			@ReviewArea(data.Area)
			if data.JSURL != "" {
				<script src={ data.JSURL } defer></script>
			}
		</div>
	}
}

// ReviewArea 是复习页主区域，也是评分/动作请求返回的片段（htmx outerHTML swap 目标）。
// 计数器、当前卡片、评分与动作控件都自包含于这里，因此评分响应就是“下一张卡”。
//
// 作答类题型（M3-12）分两种状态：
//   - 未作答：data.Graded 非空，渲染输入控件（文本/数值/单选/多选/正误）代替四档自评；
//   - 已判分：data.Result 非空，展示正确答案与判分细节，点“继续”才换下一张卡。
templ ReviewArea(data ReviewAreaData) {
	<div id="review-area" class="touch-manipulation select-none" data-answer-url={ data.AnswerURL } data-action-url={ data.ActionURL } data-edit-href={ data.CardEditHref }>
		<div class="flex items-center justify-between rounded-xl border border-zinc-200/80 bg-white px-5 py-3 text-sm shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
			<span class="inline-flex items-center gap-2 text-zinc-500 dark:text-zinc-400 font-medium">
				<span class="h-2 w-2 rounded-full bg-indigo-500"></span>
				{ data.RemainingLabel } <span id="review-remaining" class="font-semibold text-slate-900">{ data.RemainingCount }</span>
			</span>
			<span class="inline-flex items-center gap-2 text-zinc-500 dark:text-zinc-400 font-medium">
				<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
				{ data.DoneLabel } <span id="review-done" class="font-semibold text-slate-900">{ data.DoneCount }</span>
			</span>
		</div>
		<p id="review-offline" class="mt-4 hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">{ data.NetworkErrorText }</p>
		if data.ErrorText != "" {
			<p id="review-error" class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-300 shadow-xs" role="alert">{ data.ErrorText }</p>
		}
		if data.Empty {
			<div class="mt-6 rounded-2xl border border-zinc-200/80 bg-white p-10 text-center shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
				<p class="text-base text-zinc-600 dark:text-zinc-400 font-medium">{ data.EmptyText }</p>
			</div>
		} else if data.Card != nil {
			<article id="review-card" class={ reviewCardClass(data.Result) }>
				<p class="text-[11px] font-semibold tracking-wider text-zinc-500 dark:text-zinc-400 uppercase">{ data.FrontLabel }</p>
				<div class="mt-3 text-xl sm:text-2xl font-medium text-zinc-900 dark:text-zinc-100 leading-relaxed break-words">
					@rawHTML(data.Card.FrontHTML)
				</div>
				<div id="review-answer" class="mt-6 hidden border-t border-dashed border-zinc-200 dark:border-zinc-800 pt-6">
					<p class="text-[11px] font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">{ data.BackLabel }</p>
					<div class="mt-3 text-xl sm:text-2xl font-medium text-zinc-900 dark:text-zinc-100 leading-relaxed break-words">
						@rawHTML(data.Card.BackHTML)
					</div>
				</div>
			</article>
			if data.Result != nil {
				<div id="review-result" class={ reviewResultClass(data.Result.VerdictStatus) }>
					<div class="flex items-center justify-between gap-3">
						<div class="flex items-center gap-3">
							if data.Result.VerdictStatus == "correct" {
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-900/60 dark:text-emerald-400 shadow-2xs">
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
								</span>
								<div>
									<p class="text-xl font-bold tracking-tight text-emerald-950 dark:text-emerald-100">{ data.Result.VerdictLabel }</p>
								</div>
							} else if data.Result.VerdictStatus == "incorrect" {
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-600 dark:bg-rose-900/60 dark:text-rose-400 shadow-2xs">
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
								</span>
								<div>
									<p class="text-xl font-bold tracking-tight text-rose-950 dark:text-rose-100">{ data.Result.VerdictLabel }</p>
								</div>
							} else {
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-600 dark:bg-amber-900/60 dark:text-amber-400 shadow-2xs">
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
								</span>
								<div>
									<p class="text-xl font-bold tracking-tight text-amber-950 dark:text-amber-100">{ data.Result.VerdictLabel }</p>
								</div>
							}
						</div>
						if data.Result.VerdictStatus == "correct" {
							<span class="inline-flex items-center rounded-lg bg-emerald-100 dark:bg-emerald-900/50 px-3 py-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-200 border border-emerald-300/80 dark:border-emerald-700/60 shadow-2xs">{ data.Result.ScoreLabel }: <span class="ml-1 font-mono text-sm">{ data.Result.Score }</span></span>
						} else if data.Result.VerdictStatus == "incorrect" {
							<span class="inline-flex items-center rounded-lg bg-rose-100 dark:bg-rose-900/50 px-3 py-1.5 text-xs font-bold text-rose-800 dark:text-rose-200 border border-rose-300/80 dark:border-rose-700/60 shadow-2xs">{ data.Result.ScoreLabel }: <span class="ml-1 font-mono text-sm">{ data.Result.Score }</span></span>
						} else {
							<span class="inline-flex items-center rounded-lg bg-amber-100 dark:bg-amber-900/50 px-3 py-1.5 text-xs font-bold text-amber-800 dark:text-amber-200 border border-amber-300/80 dark:border-amber-700/60 shadow-2xs">{ data.Result.ScoreLabel }: <span class="ml-1 font-mono text-sm">{ data.Result.Score }</span></span>
						}
					</div>
					<div class="rounded-xl border border-emerald-200/80 bg-white dark:border-emerald-900/60 dark:bg-zinc-900 p-4 shadow-2xs">
						<p class="text-[11px] font-bold tracking-wider text-emerald-700 dark:text-emerald-400 uppercase">{ data.Result.AnswerLabel }</p>
						<div class="mt-2 text-base font-medium text-zinc-900 dark:text-zinc-100 leading-relaxed">
							@rawHTML(data.Result.AnswerHTML)
						</div>
					</div>
					if len(data.Result.DetailLines) > 0 {
						if data.Result.VerdictStatus == "incorrect" {
							<div class="rounded-xl border border-rose-200/80 bg-rose-50/60 dark:border-rose-900/50 dark:bg-rose-950/30 p-3.5 space-y-1.5">
								for _, line := range data.Result.DetailLines {
									<p class="text-xs text-rose-900 dark:text-rose-200 font-mono"><span class="font-semibold text-rose-700 dark:text-rose-400">{ line.Label }:</span> <span class="text-rose-950 dark:text-rose-100">{ line.Value }</span></p>
								}
							</div>
						} else if data.Result.VerdictStatus == "correct" {
							<div class="rounded-xl border border-emerald-200/60 bg-emerald-50/40 dark:border-emerald-900/40 dark:bg-emerald-950/20 p-3.5 space-y-1.5">
								for _, line := range data.Result.DetailLines {
									<p class="text-xs text-emerald-900 dark:text-emerald-200 font-mono"><span class="font-semibold text-emerald-700 dark:text-emerald-400">{ line.Label }:</span> <span class="text-emerald-950 dark:text-emerald-100">{ line.Value }</span></p>
								}
							</div>
						} else {
							<div class="rounded-xl border border-amber-200/60 bg-amber-50/40 dark:border-amber-900/40 dark:bg-amber-950/20 p-3.5 space-y-1.5">
								for _, line := range data.Result.DetailLines {
									<p class="text-xs text-amber-900 dark:text-amber-200 font-mono"><span class="font-semibold text-amber-700 dark:text-amber-400">{ line.Label }:</span> <span class="text-amber-950 dark:text-amber-100">{ line.Value }</span></p>
								}
							</div>
						}
					}
					<form class="mt-2" hx-post={ data.AnswerURL } hx-target="#review-area" hx-swap="outerHTML">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<input type="hidden" name="card_id" value={ data.Card.CardID }/>
						<input type="hidden" name="note_id" value={ data.Card.NoteID }/>
						for _, v := range data.DeckValues {
							<input type="hidden" name="deck" value={ v }/>
						}
						<input type="hidden" name="done" value={ data.DoneValue }/>
						<input type="hidden" name="action" value="next"/>
						if data.Result.VerdictStatus == "correct" {
							<button id="review-continue" type="submit" class="min-h-11 w-full rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white shadow-xs hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 active:scale-[0.99] transition-all cursor-pointer">{ data.Result.ContinueLabel }</button>
						} else if data.Result.VerdictStatus == "partial" {
							<button id="review-continue" type="submit" class="min-h-11 w-full rounded-xl bg-amber-600 px-5 py-3 font-semibold text-white shadow-xs hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 active:scale-[0.99] transition-all cursor-pointer">{ data.Result.ContinueLabel }</button>
						} else {
							<button id="review-continue" type="submit" class="min-h-11 w-full rounded-xl bg-zinc-950 px-5 py-3 font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.99] transition-all cursor-pointer">{ data.Result.ContinueLabel }</button>
						}
					</form>
				</div>
				// 结果面板是"已作答、只差继续"的状态：这里也放一行快捷键提示，串由服务端按
				// 状态给（review.shortcuts_result）——此时 b（埋藏）的按钮并未渲染，不能宣传它。
				<p class="mt-3 text-center text-xs text-zinc-600 dark:text-zinc-400 font-mono font-medium">{ data.ShortcutsHint }</p>
			} else {
				<button id="review-show-answer" type="button" class="mt-6 min-h-11 w-full rounded-lg bg-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-xs hover:bg-blue-700 active:scale-[0.99] transition-all cursor-pointer">{ data.ShowAnswerLabel }</button>
				<form id="review-form" class="mt-6" hx-post={ data.AnswerURL } hx-target="#review-area" hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<input type="hidden" name="card_id" value={ data.Card.CardID }/>
					<input type="hidden" name="note_id" value={ data.Card.NoteID }/>
					for _, v := range data.DeckValues {
						<input type="hidden" name="deck" value={ v }/>
					}
					<input type="hidden" name="expected_version" value={ data.Card.ExpectedVersion }/>
					<input type="hidden" name="done" value={ data.DoneValue }/>
					<input id="review-elapsed" type="hidden" name={ data.ElapsedName } value=""/>
					if data.Graded != nil {
						<div id="review-graded" class="mt-2 space-y-3">
							if data.Graded.TypeAttr == "radio" || data.Graded.TypeAttr == "checkbox" {
								<div class="space-y-2">
									for _, opt := range data.Graded.Options {
										<label class="flex min-h-11 items-center gap-3 rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-medium text-zinc-800 hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800 cursor-pointer shadow-2xs transition-colors">
											<input type={ data.Graded.TypeAttr } name="answer" value={ opt.Value } class="h-4 w-4 text-zinc-950 focus:ring-zinc-900 border-zinc-300 dark:border-zinc-700"/>
											<span>{ opt.Label }</span>
										</label>
									}
								</div>
							} else {
								<label class="block" for="review-answer-input">
									<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{ data.Graded.AnswerLabel }</span>
									<input id="review-answer-input" class="mt-1.5 w-full rounded-xl border border-zinc-200 bg-white px-4 py-3 text-base text-zinc-900 shadow-2xs focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors" type={ data.Graded.TypeAttr } inputmode={ data.Graded.InputMode } name="answer" placeholder={ data.Graded.Placeholder } autocomplete="off"/>
								</label>
							}
							<button id="review-submit" type="submit" class="mt-3 min-h-11 w-full rounded-xl bg-zinc-950 px-5 py-3 font-semibold text-white shadow-xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white active:scale-[0.99] transition-all cursor-pointer">{ data.Graded.SubmitLabel }</button>
							// 揭示答案后的唯一出口：不判分、按 Again 记一条（DESIGN.md §8.2）。
							// 平时隐藏，由 review.js 在揭示时显示，并禁用上面的输入框与提交按钮。
							<button id="review-zero" type="submit" name="revealed" value="1" class="mt-3 hidden min-h-11 w-full rounded-xl border border-zinc-200 bg-white px-5 py-3 font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer">{ data.ZeroScoreLabel }</button>
						</div>
					} else {
						<div id="review-ratings" class="mt-2 hidden">
							<div class="grid grid-cols-4 gap-2 sm:gap-3">
								for _, r := range data.Ratings {
									<button type="submit" name="rating" value={ ratingValue(r.Value) } data-rating={ ratingValue(r.Value) } class="min-h-11 rounded-lg border border-slate-300 px-2 py-3 text-sm font-semibold shadow-2xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] transition-all cursor-pointer flex flex-col items-center justify-center">
									{ r.Label }
									if r.Interval != "" {
										<span class="mt-0.5 text-[11px] font-normal text-zinc-500 dark:text-zinc-400">{ r.Interval }</span>
									}
								</button>
								}
							</div>
						</div>
					}
				</form>
				<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
					<form id="review-actions" class="flex flex-wrap items-center gap-2" hx-post={ data.ActionURL } hx-target="#review-area" hx-swap="outerHTML">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<input type="hidden" name="card_id" value={ data.Card.CardID }/>
						<input type="hidden" name="note_id" value={ data.Card.NoteID }/>
						for _, v := range data.DeckValues {
							<input type="hidden" name="deck" value={ v }/>
						}
						<input type="hidden" name="done" value={ data.DoneValue }/>
						<button type="submit" name="action" value="bury" data-action="bury" class="min-h-11 rounded-xl border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] transition-all cursor-pointer">{ data.BuryLabel }</button>
					</form>
					<a href={ data.Card.EditHref } data-action="edit" class="inline-flex items-center min-h-11 rounded-xl border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] transition-all">{ data.EditLabel }</a>
				</div>
				// 埋藏的作用必须写在页面上：它不改变进度，只是把卡推迟到下一个复习日。
				<p class="mt-3 text-center text-xs text-zinc-500 dark:text-zinc-400">{ data.BuryHint }</p>
				<p class="mt-4 text-center text-xs text-zinc-600 dark:text-zinc-400 font-mono font-medium">{ data.ShortcutsHint }</p>
			}
		}
	</div>
}
