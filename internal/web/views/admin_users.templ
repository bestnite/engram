package views

// adminUsers 渲染用户管理页（M6-2）：搜索、新建、按用户的操作与用量计数。
// 所有文案都来自 AdminPageData；危险动作包在 <details> 里，需要额外一次点击才展开表单。
templ adminUsers(data AdminPageData) {
	<form class="mb-6 flex flex-wrap items-end gap-3" method="get" action="/admin/users">
		<label class="text-sm text-slate-600">
			{ data.SearchLabel }
			<input class="mt-1 block rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="q" value={ data.SearchQuery }/>
		</label>
		<button class="rounded-lg border border-slate-300 px-4 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100" type="submit">{ data.SearchSubmit }</button>
	</form>

	if data.TempPassword != "" {
		<div class="mb-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
			<p class="font-medium">{ data.TempPasswordLabel }</p>
			<code class="mt-1 block font-mono text-base">{ data.TempPassword }</code>
		</div>
	}

	<section class="mb-8 border-b border-slate-200 pb-6">
		<h2 class="text-sm font-semibold text-slate-500">{ data.CreateHeading }</h2>
		<form class="mt-3 grid gap-3 sm:grid-cols-2" method="post" action="/admin/users">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<label class="text-sm text-slate-600">
				{ data.CreateUsernameLabel }
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="text" name="username" value=""/>
			</label>
			<label class="text-sm text-slate-600">
				{ data.CreateEmailLabel }
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="email" name="email" value=""/>
			</label>
			<label class="text-sm text-slate-600">
				{ data.CreatePasswordLabel }
				<input class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" type="password" name="password" value="" autocomplete="new-password"/>
			</label>
			<label class="text-sm text-slate-600">
				{ data.CreateRoleLabel }
				<select class="mt-1 block w-full rounded border border-slate-300 px-2 py-1 text-sm" name="role">
					for _, opt := range data.Roles {
						<option value={ opt.Value }>{ opt.Label }</option>
					}
				</select>
			</label>
			<div class="sm:col-span-2">
				<button class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" type="submit">{ data.CreateSubmit }</button>
			</div>
		</form>
	</section>

	if data.Total == 0 {
		<p class="text-sm text-slate-500">{ data.EmptyLabel }</p>
	} else {
		<table class="w-full text-left text-sm">
			<thead>
				<tr class="border-b border-slate-200 text-xs text-slate-400">
					<th class="py-2 pr-3 font-medium">{ data.ColUser }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColEmail }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColRole }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColStatus }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColDecks }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColCards }</th>
					<th class="py-2 pr-3 font-medium">{ data.ColReviews }</th>
					<th class="py-2 font-medium">{ data.ColActions }</th>
				</tr>
			</thead>
			<tbody>
				for _, u := range data.Users {
					<tr class="border-b border-slate-100 align-top">
						<td class="py-3 pr-3">
							<div class="font-medium text-slate-800">{ u.DisplayName }</div>
							<div class="text-xs text-slate-400">{ u.Username }</div>
						</td>
						<td class="py-3 pr-3 text-slate-600">{ u.Email }</td>
						<td class="py-3 pr-3 text-slate-600">{ u.RoleLabel }</td>
						<td class="py-3 pr-3 text-slate-600">{ u.StatusLabel }</td>
						<td class="py-3 pr-3 text-slate-600">{ u.Decks }</td>
						<td class="py-3 pr-3 text-slate-600">{ u.Cards }</td>
						<td class="py-3 pr-3 text-slate-600">{ u.Reviews }</td>
						<td class="py-3 space-y-2 text-xs">
							if !u.IsSelf {
								<form method="post" action={ u.HrefStatus }>
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
									if u.Status == "disabled" {
										<input type="hidden" name="action" value="enable"/>
										<button class="rounded border border-slate-300 px-2 py-1 text-slate-700 hover:bg-slate-100" type="submit">{ data.EnableLabel }</button>
									} else {
										<input type="hidden" name="action" value="disable"/>
										<button class="rounded border border-slate-300 px-2 py-1 text-slate-700 hover:bg-slate-100" type="submit">{ data.DisableLabel }</button>
									}
								</form>
							}
							<form method="post" action={ u.HrefLogout }>
								<input type="hidden" name="csrf_token" value={ data.CSRF }/>
								<button class="rounded border border-slate-300 px-2 py-1 text-slate-700 hover:bg-slate-100" type="submit">{ data.ForceLogoutLabel }</button>
							</form>
							<details>
								<summary class="cursor-pointer text-slate-600">{ data.ChangeRoleLabel }</summary>
								<form class="mt-1 space-y-1" method="post" action={ u.HrefRole }>
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
									<input type="hidden" name="confirm" value="1"/>
									<select class="block rounded border border-slate-300 px-2 py-1" name="role">
										for _, opt := range data.Roles {
											<option value={ opt.Value } selected?={ opt.Value == u.Role }>{ opt.Label }</option>
										}
									</select>
									<button class="rounded border border-slate-300 px-2 py-1 text-slate-700 hover:bg-slate-100" type="submit">{ data.ChangeRoleLabel }</button>
								</form>
							</details>
							<details>
								<summary class="cursor-pointer text-slate-600">{ data.ResetPasswordLabel }</summary>
								<form class="mt-1 space-y-1" method="post" action={ u.HrefPassword }>
									<input type="hidden" name="csrf_token" value={ data.CSRF }/>
									<input type="hidden" name="confirm" value="1"/>
									<p class="text-xs text-slate-400">{ data.ConfirmHint }</p>
									<button class="rounded border border-slate-300 px-2 py-1 text-slate-700 hover:bg-slate-100" type="submit">{ data.ResetPasswordLabel }</button>
								</form>
							</details>
							if !u.IsSelf {
								<details>
									<summary class="cursor-pointer text-red-600">{ data.DeleteLabel }</summary>
									<form class="mt-1 space-y-1" method="post" action={ u.HrefDelete }>
										<input type="hidden" name="csrf_token" value={ data.CSRF }/>
										<input type="hidden" name="confirm" value="1"/>
										<p class="text-xs text-slate-400">{ data.ConfirmHint }</p>
										<button class="rounded border border-red-300 px-2 py-1 text-red-700 hover:bg-red-50" type="submit">{ data.DeleteLabel }</button>
									</form>
								</details>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}

	<nav class="mt-4 flex items-center gap-4 text-sm text-slate-500">
		if data.PrevHref != "" {
			<a class="rounded border border-slate-300 px-3 py-1 hover:bg-slate-100" href={ data.PrevHref }>{ data.PrevLabel }</a>
		}
		if data.NextHref != "" {
			<a class="rounded border border-slate-300 px-3 py-1 hover:bg-slate-100" href={ data.NextHref }>{ data.NextLabel }</a>
		}
	</nav>
}
