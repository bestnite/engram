# Dockerfile for the release image, built by GoReleaser's dockers_v2 (configuration in .goreleaser.yaml).
#
# Key difference from the Dockerfile that builds from source: the build context is the temporary directory goreleaser produces, not the repository root.
# That directory holds only build artifacts — Go binaries laid out as <os>/<arch>/<name>, extra_files keeping their original relative paths,
# and neither the repository sources nor .dockerignore inside it.
#
# The predefined $TARGETPLATFORM / $TARGETARCH arguments only exist with multi-platform builds (buildx);
# goreleaser v2's dockers_v2 goes through buildx. Giving neither a default is deliberate: if it ever degrades to a build
# without a platform, the empty arguments make COPY take files from the wrong place and fail immediately, instead of silently
# stuffing one architecture's binary into another architecture's image.
ARG TARGETPLATFORM
ARG TARGETARCH

# ---- runtime stage: alpine + tzdata, non-root, kept consistent with the Dockerfile's runtime stage ----
FROM alpine:3.22

# tzdata is for user timezones/review-day cutovers; ca-certificates is for future OIDC egress.
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 -h /app app \
    && mkdir -p /data/media \
    && chown -R 10001:10001 /data

ARG TARGETPLATFORM
ARG TARGETARCH
COPY ${TARGETPLATFORM}/engram /usr/local/bin/engram
# FSRS optimizer adapter: internal/jobs resolves /usr/local/bin/optimizer next to the service binary by default,
# so when the canonical path matches, OPTIMIZER_PATH is unnecessary; the artifact is musl statically linked and runs as-is.
COPY tools/optimizer/dist/linux/${TARGETARCH}/optimizer /usr/local/bin/optimizer

USER 10001:10001
WORKDIR /app

# Default single-host shape: SQLite + automatic migration on startup. The secrets are placeholder values;
# a real deployment must override them via environment variables, and the image carries no real credentials.
ENV HTTP_ADDR=0.0.0.0:8080 \
    DB_DRIVER=sqlite \
    DB_DSN=/data/engram.db \
    AUTO_MIGRATE=1 \
    MEDIA_DIR=/data/media \
    BASE_URL=http://localhost:8080

# SESSION_SECRET and ENCRYPTION_KEY deliberately have no default values: baking a known secret into the image would turn
# "forgot to override" into a silent weak-key deployment; a missing value at runtime fails fast with an English error (internal/config validates it).

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/engram"]
CMD ["serve"]
