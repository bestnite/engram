# 环境变量示例（占位符，勿填写真实值；.env 已被 gitignore 忽略）
# 只有"启动必需项"在这里；其余可改设置在管理面板里配置并存库。

# 服务监听（示例）
HTTP_ADDR=127.0.0.1:8080
BASE_URL=https://flashcard.example.com

# 数据库：默认 PostgreSQL；单机/开发可用 SQLite（两者都支持，见 DESIGN.md §2.3）
DB_DRIVER=postgres
DB_DSN=postgres://flashcard:CHANGE_ME@localhost:5432/flashcard?sslmode=disable
# DB_DRIVER=sqlite
# DB_DSN=data/flashcard.db

# 会话与加密主密钥（生成方式：openssl rand -base64 32）
SESSION_SECRET=CHANGE_ME_BASE64_32_BYTES
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# 启动时自动迁移（生产建议由 `flashcard schema sync` 显式执行）
AUTO_MIGRATE=1

# 首个管理员兜底（也可首次启动时在网页引导页创建）
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# 媒体目录
MEDIA_DIR=data/media
# 媒体上传上限（可选环境变量覆盖；留空时用系统设置 media_max_bytes，再回退默认 10 MiB）
# MEDIA_MAX_BYTES=10485760
# 每用户媒体总量配额（可选环境变量覆盖；留空时用系统设置 media_user_quota_bytes；0 = 不限）
# MEDIA_USER_QUOTA_BYTES=104857600
