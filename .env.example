# Environment variable example (placeholders only — never put real values here; .env is gitignored)
# Only the startup-required items are listed; everything else can be set in the admin panel and stored in the database.

# Service listener (example)
HTTP_ADDR=127.0.0.1:8080
BASE_URL=https://engram.example.com

# Database: PostgreSQL by default; SQLite works for single-node/development (both are supported)
DB_DRIVER=postgres
DB_DSN=postgres://engram:***@localhost:5432/engram?sslmode=disable
# DB_DRIVER=sqlite
# DB_DSN=data/engram.db

# Session and encryption master keys (generate with: openssl rand -base64 32)
SESSION_SECRET=CHANGE_ME_BASE64_32_BYTES
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Run migrations at startup (in production, prefer an explicit `engram schema sync`)
AUTO_MIGRATE=1

# First-admin fallback (you can also create it from the setup page on first start)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Media directory
MEDIA_DIR=data/media
# Per-file upload limit (optional environment override; when empty, the media_max_bytes setting is used, falling back to 10 MiB)
# MEDIA_MAX_BYTES=10485760
# Per-user media quota (optional environment override; when empty, the media_user_quota_bytes setting is used; 0 = unlimited)
# MEDIA_USER_QUOTA_BYTES=104857600

# FSRS parameter optimiser adapter (optional).
# When empty, the server looks for an "optimizer" binary next to the server binary,
# then falls back to the repository build path tools/optimizer/target/release/optimizer
# (development and test builds). Set this to an absolute path to pin a specific build.
# OPTIMIZER_PATH=/usr/local/bin/optimizer

# SMTP email (optional component; empty means unconfigured, and email-dependent flows are disabled).
# Normally configured on the "Email (SMTP)" page in the admin panel and stored in the database; these are optional environment overrides.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=no-reply@example.com
# SMTP_TLS_MODE=starttls
